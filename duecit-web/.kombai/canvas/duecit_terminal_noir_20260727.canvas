    "var_31547af028bc": {
      "type": "variant",
      "label": "DuecIt — Terminal Noir Profile",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5680,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  .tn-profile {\n    --ink: #010b13;\n    --carbon: #1b1b1b;\n    --carbon-2: #222222;\n    --rule: #30363b;\n    --rule-soft: #20272c;\n    --text: #e6ece8;\n    --muted: #82908b;\n    --faint: #4c5b58;\n    --green: #00ff40;\n    --green-dim: rgba(0,255,64,.12);\n    --amber: #f3b94b;\n    --amber-dim: rgba(243,185,75,.12);\n    --red: #ff5964;\n    --red-dim: rgba(255,89,100,.12);\n    min-height: 100vh;\n    background: var(--ink);\n    color: var(--text);\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n    font-size: 13px;\n    letter-spacing: -0.01em;\n    position: relative;\n    overflow: hidden;\n    transition: background-color .35s ease, color .35s ease;\n  }\n  .tn-profile::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .42;\n    background-image: linear-gradient(to right, rgba(48,54,59,.42) 1px, transparent 1px), linear-gradient(to bottom, rgba(48,54,59,.22) 1px, transparent 1px);\n    background-size: 80px 80px;\n    mask-image: linear-gradient(to bottom, rgba(0,0,0,.8), transparent 82%);\n  }\n  .tn-shell { position: relative; max-width: 1120px; margin: 0 auto; padding: 0 28px 56px; }\n  .tn-topbar { height: 68px; border-bottom: 1px solid var(--rule); display:flex; align-items:center; justify-content:space-between; gap:24px; position:relative; }\n  .tn-brand { display:flex; align-items:center; gap:11px; color:var(--text); text-decoration:none; font-family:'Space Grotesk', sans-serif; font-weight:700; letter-spacing:-.03em; font-size:16px; }\n  .tn-mark { width:26px; height:26px; display:grid; place-items:center; border:1px solid var(--green); color:var(--green); font-family:'JetBrains Mono', monospace; font-size:12px; }\n  .tn-command { display:flex; align-items:center; gap:10px; color:var(--muted); font-size:11px; }\n  .tn-command b { color:var(--green); font-weight:500; }\n  .tn-command span { color:var(--faint); }\n  .tn-nav-actions { display:flex; align-items:center; gap:18px; }\n  .tn-link { color:var(--muted); text-decoration:none; font-size:11px; transition:color .18s ease; }\n  .tn-link:hover { color:var(--green); }\n  .tn-theme { display:flex; align-items:center; gap:8px; color:var(--muted); border:1px solid var(--rule); background:transparent; font-family:inherit; font-size:10px; padding:7px 9px; cursor:pointer; transition:border-color .18s ease, color .18s ease, background-color .25s ease; }\n  .tn-theme:hover { color:var(--text); border-color:var(--green); }\n  .tn-theme-dot { width:7px; height:7px; border:1px solid var(--green); border-radius:50%; position:relative; }\n  .tn-theme-dot::after { content:''; position:absolute; inset:2px; background:var(--green); border-radius:50%; opacity:.8; }\n  .tn-kicker { margin-top:54px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--rule); padding-bottom:12px; color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.12em; }\n  .tn-kicker-left { display:flex; align-items:center; gap:10px; }\n  .tn-live { display:inline-flex; align-items:center; gap:7px; color:var(--green); }\n  .tn-pulse { width:6px; height:6px; background:var(--green); border-radius:50%; animation:tn-pulse 1.8s ease-in-out infinite; }\n  @keyframes tn-pulse { 0%,100%{opacity:1; transform:scale(1)} 50%{opacity:.38; transform:scale(.78)} }\n  .tn-identity { display:grid; grid-template-columns: 1.55fr 1fr 1fr 1fr; min-height:174px; border-bottom:1px solid var(--rule); }\n  .tn-identity > div { padding:24px 22px 22px 0; border-right:1px solid var(--rule); margin-right:22px; }\n  .tn-identity > div:last-child { border-right:0; margin-right:0; padding-right:0; }\n  .tn-label { color:var(--muted); text-transform:uppercase; letter-spacing:.12em; font-size:10px; }\n  .tn-handle { margin-top:13px; font-family:'Space Grotesk', sans-serif; font-size:48px; line-height:.98; font-weight:600; letter-spacing:-.065em; color:var(--text); }\n  .tn-handle em { color:var(--green); font-style:normal; }\n  .tn-meta { margin-top:16px; color:var(--muted); font-size:11px; line-height:1.7; }\n  .tn-meta b { color:var(--text); font-weight:500; }\n  .tn-value { margin-top:19px; font-size:28px; line-height:1; font-weight:600; color:var(--text); letter-spacing:-.04em; }\n  .tn-value.green { color:var(--green); }\n  .tn-rank { margin-top:11px; color:var(--green); font-size:11px; }\n  .tn-rank::before { content:'// '; color:var(--faint); }\n  .tn-record { margin-top:17px; display:flex; align-items:baseline; gap:4px; }\n  .tn-record strong { font-size:25px; font-weight:600; color:var(--text); }\n  .tn-record small { color:var(--faint); font-size:11px; }\n  .tn-sub { margin-top:10px; color:var(--muted); font-size:10px; }\n  .tn-section-head { display:flex; align-items:end; justify-content:space-between; gap:18px; padding:34px 0 14px; border-bottom:1px solid var(--rule); }\n  .tn-section-title { font-family:'Space Grotesk', sans-serif; font-size:19px; font-weight:600; letter-spacing:-.04em; }\n  .tn-section-title span { color:var(--green); }\n  .tn-section-meta { color:var(--muted); font-size:10px; }\n  .tn-proportion { display:grid; grid-template-columns: 2fr 1fr .75fr; gap:1px; background:var(--rule); border:1px solid var(--rule); margin-top:18px; }\n  .tn-proportion > div { background:var(--carbon); padding:15px 16px 14px; min-height:68px; }\n  .tn-proportion > div:nth-child(2) { background:#20201d; }\n  .tn-proportion > div:nth-child(3) { background:#21191c; }\n  .tn-proportion-bar { height:5px; display:flex; gap:2px; margin:12px 0 10px; }\n  .tn-proportion-bar i { display:block; height:100%; }\n  .tn-proportion-bar i:nth-child(1){ width:64%; background:var(--green); }\n  .tn-proportion-bar i:nth-child(2){ width:21%; background:var(--amber); }\n  .tn-proportion-bar i:nth-child(3){ width:15%; background:var(--red); }\n  .tn-prop-label { display:flex; align-items:center; justify-content:space-between; font-size:10px; color:var(--muted); }\n  .tn-prop-label b { color:var(--text); font-weight:600; }\n  .tn-green { color:var(--green)!important; }\n  .tn-amber { color:var(--amber)!important; }\n  .tn-red { color:var(--red)!important; }\n  .tn-history { margin-top:26px; border-top:1px solid var(--rule); }\n  .tn-table-head, .tn-row { display:grid; grid-template-columns: 24px minmax(220px, 1.55fr) 72px 88px 92px 106px 92px 102px; column-gap:16px; align-items:center; }\n  .tn-table-head { min-height:38px; border-bottom:1px solid var(--rule); color:var(--muted); font-size:9px; text-transform:uppercase; letter-spacing:.12em; }\n  .tn-row { min-height:67px; border-bottom:1px solid var(--rule-soft); position:relative; transition:background-color .18s ease; }\n  .tn-row:hover { background:rgba(0,255,64,.035); }\n  .tn-spine { align-self:stretch; display:flex; justify-content:center; position:relative; }\n  .tn-spine::before { content:''; width:1px; background:var(--rule); position:absolute; top:0; bottom:0; }\n  .tn-dot { width:7px; height:7px; z-index:1; background:var(--carbon); border:1px solid var(--green); position:relative; top:27px; }\n  .tn-dot.draw { border-color:var(--amber); }\n  .tn-dot.loss { border-color:var(--red); }\n  .tn-problem { min-width:0; }\n  .tn-problem strong { display:block; color:var(--text); font-family:'Space Grotesk', sans-serif; font-size:13px; font-weight:600; letter-spacing:-.02em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .tn-problem small { display:block; color:var(--muted); font-size:10px; margin-top:5px; }\n  .tn-cell { color:var(--muted); font-size:10px; }\n  .tn-cell.mono { color:var(--text); font-size:11px; }\n  .tn-badge { display:inline-flex; align-items:center; gap:6px; padding:4px 6px; border:1px solid var(--rule); color:var(--muted); font-size:9px; text-transform:uppercase; letter-spacing:.08em; }\n  .tn-badge.easy { color:var(--green); border-color:rgba(0,255,64,.35); background:var(--green-dim); }\n  .tn-badge.medium { color:var(--amber); border-color:rgba(243,185,75,.35); background:var(--amber-dim); }\n  .tn-badge.hard { color:var(--red); border-color:rgba(255,89,100,.35); background:var(--red-dim); }\n  .tn-result { display:inline-flex; align-items:center; gap:7px; font-size:10px; }\n  .tn-result::before { content:''; width:5px; height:5px; background:currentColor; }\n  .tn-result.win { color:var(--green); }\n  .tn-result.draw { color:var(--amber); }\n  .tn-result.loss { color:var(--red); }\n  .tn-delta { font-size:11px; font-weight:600; }\n  .tn-delta.pos { color:var(--green); }\n  .tn-delta.neutral { color:var(--amber); }\n  .tn-delta.neg { color:var(--red); }\n  .tn-time { color:var(--muted); font-size:10px; line-height:1.45; }\n  .tn-time b { color:var(--text); display:block; font-weight:500; }\n  .tn-state-label { color:var(--faint); font-size:9px; text-transform:uppercase; letter-spacing:.1em; }\n  .tn-state-row { display:grid; grid-template-columns:24px 1fr 190px; column-gap:16px; align-items:center; min-height:59px; border-bottom:1px solid var(--rule-soft); }\n  .tn-empty { color:var(--muted); font-size:11px; }\n  .tn-empty b { color:var(--text); font-weight:500; }\n  .tn-empty span { color:var(--faint); margin-left:11px; }\n  .tn-skeleton { height:8px; width:150px; background:linear-gradient(90deg, var(--rule) 25%, var(--carbon-2) 50%, var(--rule) 75%); background-size:200% 100%; animation:tn-shimmer 1.5s ease-in-out infinite; }\n  @keyframes tn-shimmer { from{background-position:200% 0} to{background-position:-200% 0} }\n  .tn-footer { display:flex; align-items:center; justify-content:space-between; padding-top:26px; color:var(--faint); font-size:10px; }\n  .tn-footer code { color:var(--muted); }\n  .tn-footer .tn-green { font-weight:600; }\n  .tn-light { --ink:#eef1ed; --carbon:#ffffff; --carbon-2:#f2f4f1; --rule:#c9d1cb; --rule-soft:#dfe4e0; --text:#122019; --muted:#53645a; --faint:#87948c; --green:#087a2c; --green-dim:rgba(8,122,44,.09); --amber:#9b6500; --amber-dim:rgba(155,101,0,.09); --red:#b62531; --red-dim:rgba(182,37,49,.09); }\n  @media (max-width: 900px) {\n    .tn-shell { padding:0 18px 42px; }\n    .tn-command { display:none; }\n    .tn-identity { grid-template-columns:1.4fr 1fr 1fr; }\n    .tn-identity > div:nth-child(4){ display:none; }\n    .tn-table-head, .tn-row { grid-template-columns:18px minmax(190px, 1.5fr) 74px 86px 88px 100px; }\n    .tn-table-head > :nth-child(7), .tn-table-head > :nth-child(8), .tn-row > :nth-child(7), .tn-row > :nth-child(8) { display:none; }\n  }\n</style>\n<div class=\"tn-profile\" data-kid=\"1\" id=\"tnProfile\">\n    <div class=\"tn-shell\" data-kid=\"1-1\">\n        <header class=\"tn-topbar\" data-kid=\"1-1-1\">\n            <a class=\"tn-brand\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"tn-mark\" data-kid=\"1-1-1-1-1\">\n                    >_\n                </span>\n                <span data-kid=\"1-1-1-1-2\">\n                    DuecIt\n                </span>\n            </a>\n            <div class=\"tn-command\" data-kid=\"1-1-1-2\">\n                <b data-kid=\"1-1-1-2-1\">\n                    profile\n                </b>\n                <span data-kid=\"1-1-1-2-2\">\n                    /\n                </span>\n                <span data-kid=\"1-1-1-2-3\">\n                    public\n                </span>\n                <span data-kid=\"1-1-1-2-4\">\n                    /\n                </span>\n                <span data-kid=\"1-1-1-2-5\">\n                    @alex_k\n                </span>\n            </div>\n            <div class=\"tn-nav-actions\" data-kid=\"1-1-1-3\">\n                <a class=\"tn-link\" data-kid=\"1-1-1-3-1\" href=\"#history\">\n                    duels\n                </a>\n                <a class=\"tn-link\" data-kid=\"1-1-1-3-2\" href=\"#stats\">\n                    rating\n                </a>\n                <button aria-label=\"Toggle theme\" class=\"tn-theme\" data-kid=\"1-1-1-3-3\" id=\"tnTheme\" type=\"button\">\n                    <span class=\"tn-theme-dot\" data-kid=\"1-1-1-3-3-1\">\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-1-1-3-3-2\" data-name=\"theme toggle button text\" data-reason=\"text toggled between light_mode and dark_mode by script\" id=\"tnThemeText\">\n                        dark_mode\n                    </span>\n                </button>\n            </div>\n        </header>\n        <div class=\"tn-kicker\" data-kid=\"1-1-2\">\n            <div class=\"tn-kicker-left\" data-kid=\"1-1-2-1\">\n                <span class=\"tn-live\" data-kid=\"1-1-2-1-1\">\n                    <i class=\"tn-pulse\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                    online\n                </span>\n                <span data-kid=\"1-1-2-1-2\">\n                    ·\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-1-2-1-3\" data-name=\"last active timestamp\" data-reason=\"text replaced by dynamic countdown timer script\">\n                    last seen 2m ago\n                </span>\n            </div>\n            <span data-kid=\"1-1-2-2\">\n                identity://developer\n            </span>\n        </div>\n        <section class=\"tn-identity\" data-kid=\"1-1-3\" id=\"stats\">\n            <div data-kid=\"1-1-3-1\">\n                <div class=\"tn-label\" data-kid=\"1-1-3-1-1\">\n                    handle\n                </div>\n                <div class=\"tn-handle\" data-kid=\"1-1-3-1-2\">\n                    <em data-kid=\"1-1-3-1-2-1\">\n                        @\n                    </em>\n                    alex_k\n                </div>\n                <div class=\"tn-meta\" data-kid=\"1-1-3-1-3\">\n                    member since\n                    <b data-kid=\"1-1-3-1-3-1\" data-name=\"member registration date\">\n                        2024.03.18\n                    </b>\n                    <br data-kid=\"1-1-3-1-3-2\"/>\n                    preferred runtime\n                    <b data-kid=\"1-1-3-1-3-3\" data-name=\"preferred programming language\">\n                        python 3.12\n                    </b>\n                </div>\n            </div>\n            <div data-kid=\"1-1-3-2\">\n                <div class=\"tn-label\" data-kid=\"1-1-3-2-1\">\n                    dsa rating\n                </div>\n                <div class=\"tn-value green\" data-dynamic=\"true\" data-kid=\"1-1-3-2-2\" data-name=\"current DSA rating value\" data-reason=\"rating value fetched and injected by script\">\n                    1842\n                </div>\n                <div class=\"tn-rank\" data-kid=\"1-1-3-2-3\">\n                    candidate master\n                </div>\n                <div class=\"tn-sub\" data-dynamic=\"true\" data-kid=\"1-1-3-2-4\" data-name=\"rating change label\" data-reason=\"change delta calculated and injected by script\">\n                    +42 this season\n                </div>\n            </div>\n            <div data-kid=\"1-1-3-3\">\n                <div class=\"tn-label\" data-kid=\"1-1-3-3-1\">\n                    match record\n                </div>\n                <div class=\"tn-record\" data-kid=\"1-1-3-3-2\">\n                    <strong data-dynamic=\"true\" data-kid=\"1-1-3-3-2-1\" data-name=\"total match wins\" data-reason=\"stat count fetched and injected by script\">\n                        18\n                    </strong>\n                    <small data-kid=\"1-1-3-3-2-2\">\n                        W\n                    </small>\n                    <strong data-dynamic=\"true\" data-kid=\"1-1-3-3-2-3\" data-name=\"total match draws\" data-reason=\"stat count fetched and injected by script\">\n                        · 6\n                    </strong>\n                