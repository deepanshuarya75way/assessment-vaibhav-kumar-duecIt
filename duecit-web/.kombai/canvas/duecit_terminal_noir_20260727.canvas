dynamic=\"true\" data-kid=\"1-2-6-2-1-1-1\" data-name=\"first solution author name\" data-reason=\"author name injected\">\n                            sarah_codes\n                        </span>\n                        <span class=\"tag\" data-kid=\"1-2-6-2-1-1-2\" data-name=\"solution tag container\">\n                            python 3 ·\n                            <span class=\"accepted\" data-kid=\"1-2-6-2-1-1-2-1\" data-name=\"accepted status\">\n                                accepted\n                            </span>\n                        </span>\n                    </span>\n                    <span class=\"chevron\" data-kid=\"1-2-6-2-1-2\" data-name=\"chevron icon\">\n                        ⌄\n                    </span>\n                </summary>\n                <div class=\"code-wrap\" data-kid=\"1-2-6-2-2\" data-name=\"code block wrapper\">\n                    <pre data-dynamic=\"true\" data-kid=\"1-2-6-2-2-1\" data-name=\"solution code snippet\" data-reason=\"source code content injected by backend\"><span class=\"ln\" data-kid=\"1-2-6-2-2-1-1\" data-name=\"line number 01\">01</span><span class=\"kw\" data-kid=\"1-2-6-2-2-1-2\" data-name=\"class keyword\">class</span> <span class=\"fn\" data-kid=\"1-2-6-2-2-1-3\" data-name=\"class name\">LRUCache</span>:\n<span class=\"ln\" data-kid=\"1-2-6-2-2-1-4\" data-name=\"line number 02\">02</span>    <span class=\"kw\" data-kid=\"1-2-6-2-2-1-5\" data-name=\"def keyword\">def</span> <span class=\"fn\" data-kid=\"1-2-6-2-2-1-6\" data-name=\"function name\">get</span>(self, key):\n<span class=\"ln\" data-kid=\"1-2-6-2-2-1-7\" data-name=\"line number 03\">03</span>        <span class=\"kw\" data-kid=\"1-2-6-2-2-1-8\" data-name=\"if keyword\">if</span> key <span class=\"kw\" data-kid=\"1-2-6-2-2-1-9\" data-name=\"operator\">not in</span> self.cache:\n<span class=\"ln\" data-kid=\"1-2-6-2-2-1-10\" data-name=\"line number 04\">04</span>            <span class=\"kw\" data-kid=\"1-2-6-2-2-1-11\" data-name=\"return keyword\">return</span> -<span class=\"str\" data-kid=\"1-2-6-2-2-1-12\" data-name=\"numeric constant\">1</span>\n<span class=\"ln\" data-kid=\"1-2-6-2-2-1-13\" data-name=\"line number 05\">05</span>        self._touch(key)\n<span class=\"ln\" data-kid=\"1-2-6-2-2-1-14\" data-name=\"line number 06\">06</span>        <span class=\"kw\" data-kid=\"1-2-6-2-2-1-15\" data-name=\"return keyword\">return</span> self.cache[key]\n<span class=\"ln\" data-kid=\"1-2-6-2-2-1-16\" data-name=\"line number 07\">07</span>    <span class=\"cm\" data-kid=\"1-2-6-2-2-1-17\" data-name=\"comment text\"># O(1) lookup · O(1) eviction</span></pre>\n                </div>\n            </details>\n            <details data-kid=\"1-2-6-3\" data-name=\"loser details element\">\n                <summary data-kid=\"1-2-6-3-1\" data-name=\"loser summary\">\n                    <span class=\"solution-title\" data-kid=\"1-2-6-3-1-1\" data-name=\"loser solution meta\">\n                        <span data-dynamic=\"true\" data-kid=\"1-2-6-3-1-1-1\" data-name=\"second solution author name\" data-reason=\"author name injected\">\n                            devkumar_19\n                        </span>\n                        <span class=\"tag\" data-kid=\"1-2-6-3-1-1-2\" data-name=\"solution tag container\">\n                            python 3 ·\n                            <span class=\"negative\" data-kid=\"1-2-6-3-1-1-2-1\" data-name=\"wrong answer status\">\n                                wrong answer\n                            </span>\n                        </span>\n                    </span>\n                    <span class=\"chevron\" data-kid=\"1-2-6-3-1-2\" data-name=\"chevron icon\">\n                        ⌄\n                    </span>\n                </summary>\n                <div class=\"code-wrap\" data-kid=\"1-2-6-3-2\" data-name=\"code block wrapper\">\n                    <pre data-dynamic=\"true\" data-kid=\"1-2-6-3-2-1\" data-name=\"solution code snippet\" data-reason=\"source code content injected by backend\"><span class=\"ln\" data-kid=\"1-2-6-3-2-1-1\" data-name=\"line number 01\">01</span><span class=\"kw\" data-kid=\"1-2-6-3-2-1-2\" data-name=\"def keyword\">def</span> <span class=\"fn\" data-kid=\"1-2-6-3-2-1-3\" data-name=\"function name\">solve</span>(ops):\n<span class=\"ln\" data-kid=\"1-2-6-3-2-1-4\" data-name=\"line number 02\">02</span>    cache = {}\n<span class=\"ln\" data-kid=\"1-2-6-3-2-1-5\" data-name=\"line number 03\">03</span>    <span class=\"kw\" data-kid=\"1-2-6-3-2-1-6\" data-name=\"for keyword\">for</span> op <span class=\"kw\" data-kid=\"1-2-6-3-2-1-7\" data-name=\"in keyword\">in</span> ops:\n<span class=\"ln\" data-kid=\"1-2-6-3-2-1-8\" data-name=\"line number 04\">04</span>        <span class=\"kw\" data-kid=\"1-2-6-3-2-1-9\" data-name=\"if keyword\">if</span> op[<span class=\"str\" data-kid=\"1-2-6-3-2-1-10\" data-name=\"index constant\">0</span>] == <span class=\"str\" data-kid=\"1-2-6-3-2-1-11\" data-name=\"string constant\">'get'</span>:\n<span class=\"ln\" data-kid=\"1-2-6-3-2-1-12\" data-name=\"line number 05\">05</span>            <span class=\"kw\" data-kid=\"1-2-6-3-2-1-13\" data-name=\"return keyword\">return</span> cache.get(op[<span class=\"str\" data-kid=\"1-2-6-3-2-1-14\" data-name=\"index constant\">1</span>], -<span class=\"str\" data-kid=\"1-2-6-3-2-1-15\" data-name=\"numeric constant\">1</span>)</pre>\n                </div>\n            </details>\n        </section>\n        <footer class=\"commands\" data-kid=\"1-2-7\" data-name=\"footer navigation area\">\n            <div data-kid=\"1-2-7-1\" data-name=\"command links group\">\n                <span data-kid=\"1-2-7-1-1\" data-name=\"command prompt icon\">\n                    >\n                </span>\n                <a data-kid=\"1-2-7-1-2\" data-name=\"play again link\" href=\"#\">\n                    play_again\n                </a>\n                <span class=\"mx-4\" data-kid=\"1-2-7-1-3\" data-name=\"separator dot\">\n                    ·\n                </span>\n                <span data-kid=\"1-2-7-1-4\" data-name=\"command prompt icon\">\n                    >\n                </span>\n                <a data-kid=\"1-2-7-1-5\" data-name=\"share report link\" href=\"#\">\n                    share_report\n                </a>\n            </div>\n            <span data-kid=\"1-2-7-2\" data-name=\"footer message text\">\n                every match is a lesson. win or lose.\n            </span>\n        </footer>\n    </main>\n</div>\n<script>\n    lucide.createIcons();\n</script>\n",
