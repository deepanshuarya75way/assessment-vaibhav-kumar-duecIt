    "var_dbcc06c1ccdc": {
      "type": "variant",
      "label": "DuecIt — Terminal Noir Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4300,
        "y": 0,
        "w": 1280,
        "h": 800
