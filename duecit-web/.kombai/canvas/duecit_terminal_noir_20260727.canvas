v class=\"mt-5 flex gap-2\" data-kid=\"1-3-2-5-2-3\">\n                        <span class=\"tn-key\" data-kid=\"1-3-2-5-2-3-1\">\n                            python\n                        </span>\n                        <span class=\"tn-key\" data-kid=\"1-3-2-5-2-3-2\">\n                            cpp\n                        </span>\n                        <span class=\"tn-key\" data-kid=\"1-3-2-5-2-3-3\">\n                            java\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <footer class=\"mt-12 flex flex-wrap items-center justify-between gap-3 border-t tn-rule py-6 text-[10px] text-[var(--faint)]\" data-kid=\"1-3-2-6\">\n                <span data-kid=\"1-3-2-6-1\">\n                    duecit / terminal noir · build 0.8.4\n                </span>\n                <span data-kid=\"1-3-2-6-2\">\n                    every match is a lesson. win or lose.\n                </span>\n            </footer>\n        </main>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const app = document.getElementById('terminal-app');\n  if (window.lucide) window.lucide.createIcons({ attrs: { 'stroke-width': 1.6 } });\n  const savedTheme = localStorage.getItem('duecit-theme');\n  if (savedTheme) app.dataset.theme = savedTheme;\n  document.getElementById('theme-toggle')?.addEventListener('click', () => {\n    const next = app.dataset.theme === 'dark' ? 'light' : 'dark';\n    app.dataset.theme = next;\n    localStorage.setItem('duecit-theme', next);\n  });\n  const frames = ['[ / ]', '[ - ]', '[ \\\\ ]', '[ | ]'];\n  let frame = 0;\n  setInterval(() => {\n    frame = (frame + 1) % frames.length;\n    const node = document.querySelector('.ascii-frame');\n    if (node) node.textContent = frames[frame];\n  }, 650);\n</script>\n",
