        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  :root {\n    --ink: #010b13;\n    --carbon: #11171c;\n    --carbon-2: #171e24;\n    --panel: #1b1b1b;\n    --line: #2e383f;\n    --line-soft: #222b31;\n    --text: #e7eef0;\n    --muted: #87939a;\n    --faint: #5b686f;\n    --green: #00ff40;\n    --green-soft: rgba(0,255,64,.11);\n    --amber: #f4b942;\n    --amber-soft: rgba(244,185,66,.10);\n    --red: #ff5b65;\n    --blue: #78a9ff;\n  }\n  .arena * { box-sizing:border-box; }\n  body { margin:0; background:var(--ink); color:var(--text); font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; }\n  .arena { min-height:100vh; background: linear-gradient(180deg, #010b13 0%, #071017 100%); display: flex; flex-direction: column; overflow: hidden; }\n  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n  .topbar { height: 62px; border-bottom: 1px solid var(--line); background: rgba(1,11,19,.96); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; gap: 24px; flex-shrink: 0; }\n  .brand { display: flex; align-items: center; gap: 11px; min-width: 192px; }\n  .brand-mark { width: 28px; height: 28px; border: 1px solid var(--green); display: grid; place-items: center; color: var(--green); background: rgba(0,255,64,.05); }\n  .brand-mark i { width: 15px; height: 15px; }\n  .brand-name { font-size: 15px; font-weight: 700; letter-spacing: -.02em; }\n  .brand-sub { color: var(--faint); font-size: 10px; margin-left: 6px; letter-spacing: .08em; text-transform: uppercase; }\n  .match-meta { display: flex; align-items: center; gap: 15px; min-width: 0; flex: 1; }\n  .problem-id { color: var(--green); font-size: 11px; letter-spacing: .09em; }\n  .problem-name { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .divider { width: 1px; height: 20px; background: var(--line); }\n  .opponent { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; white-space: nowrap; }\n  .opponent strong { color: var(--text); font-weight: 600; }\n  .rating { color: var(--green); }\n  .top-actions { display: flex; align-items: center; gap: 9px; }\n  .phase-chip { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); padding: 7px 10px; color: var(--green); font-size: 10px; letter-spacing: .11em; }\n  .phase-chip .live-dot { width: 6px; height: 6px; background: var(--green); }\n  .timer { min-width: 104px; border: 1px solid var(--green); background: rgba(0,255,64,.04); color: var(--green); padding: 7px 10px; text-align: center; font-size: 15px; font-weight: 700; letter-spacing: .04em; }\n  .timer small { display: block; color: var(--muted); font-size: 9px; font-weight: 500; letter-spacing: .13em; margin-bottom: 2px; }\n  .warning { display: inline-flex; align-items: center; gap: 5px; border: 1px solid rgba(244,185,66,.35); color: var(--amber); padding: 7px 9px; font-size: 10px; }\n  .warning i { width: 13px; height: 13px; }\n  .theme-toggle { width: 30px; height: 30px; border: 1px solid var(--line); background: transparent; color: var(--muted); display: grid; place-items: center; cursor: pointer; }\n  .theme-toggle:hover { border-color: var(--green); color: var(--green); }\n  .theme-toggle i { width: 15px; height: 15px; }\n  .phase-strip { height: 32px; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 40% 60%; background: #0a1218; flex-shrink: 0; }\n  .phase-read, .phase-code { display: flex; align-items: center; gap: 10px; padding: 0 18px; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }\n  .phase-read { border-right: 1px solid var(--line); color: var(--amber); background: linear-gradient(90deg, var(--amber-soft), transparent); }\n  .phase-code { color: var(--green); position: relative; }\n  .phase-code:before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--green); opacity: .65; }\n  .phase-read i, .phase-code i { width: 12px; height: 12px; }\n  .phase-read span:last-child, .phase-code span:last-child { margin-left: auto; color: var(--faint); font-size: 9px; letter-spacing: .06em; }\n  .workspace { flex: 1; min-height: 0; display: grid; grid-template-columns: 40% 60%; }\n  .problem-pane { min-width: 0; border-right: 1px solid var(--line); background: #0b141a; display: flex; flex-direction: column; position: relative; }\n  .problem-pane:after { content: 'DUEL / 8F31A2'; position: absolute; inset: 0; pointer-events: none; opacity: .035; color: #cfe0e5; font: 10px/1.4 'JetBrains Mono', monospace; letter-spacing: .12em; transform: rotate(-24deg); white-space: pre; word-spacing: 34px; background: repeating-linear-gradient(0deg, transparent 0 54px, rgba(255,255,255,.4) 55px 56px); }\n  .problem-head { padding: 22px 24px 0; position: relative; z-index: 1; }\n  .eyebrow { color: var(--muted); font-size: 10px; letter-spacing: .15em; text-transform: uppercase; }\n  .problem-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-top: 9px; }\n  h1 { font-size: 28px; line-height: 1.08; margin: 0; letter-spacing: -.045em; font-weight: 700; }\n  .difficulty { border: 1px solid rgba(0,255,64,.35); color: var(--green); background: var(--green-soft); padding: 5px 8px; font: 10px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }\n  .tabs { display: flex; gap: 18px; margin-top: 23px; border-bottom: 1px solid var(--line); }\n  .tab { padding: 10px 0 9px; color: var(--muted); font-size: 11px; background: none; border: 0; font-family: inherit; cursor: pointer; position: relative; }\n  .tab.active { color: var(--text); }\n  .tab.active:after { content: ''; position: absolute; height: 2px; left: 0; right: 0; bottom: -1px; background: var(--green); }\n  .article { position: relative; z-index: 1; overflow: auto; padding: 21px 24px 28px; }\n  .article::-webkit-scrollbar, .editor-code::-webkit-scrollbar, .results::-webkit-scrollbar { width: 8px; }\n  .article::-webkit-scrollbar-thumb, .editor-code::-webkit-scrollbar-thumb, .results::-webkit-scrollbar-thumb { background: #26323a; }\n  .section-label { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; color: var(--green); font: 10px 'JetBrains Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }\n  .section-label:after { content: ''; height: 1px; flex: 1; background: var(--line); }\n  .article p { color: #c1cdd1; font-size: 13px; line-height: 1.72; max-width: 520px; margin: 0 0 22px; }\n  .article code { color: var(--green); background: #101d23; border: 1px solid var(--line-soft); padding: 2px 5px; font: 11px 'JetBrains Mono', monospace; }\n  .constraint { border-left: 2px solid var(--amber); padding: 10px 12px; background: rgba(244,185,66,.055); margin: 0 0 22px; color: #cbd2ce; font: 11px/1.65 'JetBrains Mono', monospace; }\n  .constraint b { display: block; color: var(--amber); font-size: 9px; letter-spacing: .13em; margin-bottom: 3px; }\n  .sample { border: 1px solid var(--line); margin: 0 0 13px; background: #0d171d; }\n  .sample-head { display: flex; align-items: center; justify-content: space-between; padding: 7px 10px; border-bottom: 1px solid var(--line); color: var(--muted); font: 9px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .12em; }\n  .sample-grid { display: grid; grid-template-columns: 1fr 1fr; }\n  .sample-cell { padding: 10px; min-height: 61px; }\n  .sample-cell + .sample-cell { border-left: 1px solid var(--line); }\n  .sample-cell small { display: block; color: var(--faint); font: 9px 'JetBrains Mono', monospace; text-transform: uppercase; margin-bottom: 6px; }\n  .sample-cell pre { margin: 0; color: #d7e5e4; white-space: pre-wrap; font: 11px/1.5 'JetBrains Mono', monospace; }\n  .hint { color: var(--muted); font: 10px/1.6 'JetBrains Mono', monospace; border-top: 1px solid var(--line); padding-top: 14px; margin-top: 24px; }\n  .hint b { color: var(--green); font-weight: 500; }\n  .editor-pane { min-width: 0; background: #10171c; display: flex; flex-direction: column; }\n  .editor-tabs { height: 39px; display: flex; align-items: stretch; border-bottom: 1px solid var(--line); background: #0d1419; }\n  .file-tab { display: flex; align-items: center; gap: 8px; padding: 0 15px; border-right: 1px solid var(--line); color: var(--muted); font: 11px 'JetBrains Mono', monospace; }\n  .file-tab.active { color: var(--text); background: #141d23; box-shadow: inset 0 -2px 0 var(--green); }\n  .file-tab i { width: 13px; height: 13px; color: var(--green); }\n  .editor-meta { margin-left: auto; display: flex; align-items: center; gap: 15px; padding: 0 15px; color: var(--faint); font: 10px 'JetBrains Mono', monospace; }\n  .editor-meta .opponent-progress { color: var(--green); }\n  .editor-toolbar { height: 40px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; padding: 0 15px; color: var(--muted); font-size: 11px; }\n  .select-like { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); background: #0c1419; padding: 6px 9px; color: var(--text); font: 10px 'JetBrains Mono', monospace; }\n  .select-like i { width: 12px; height: 12px; color: var(--green); }\n  .lock-note { color: var(--amber); font: 10px 'JetBrains Mono', monospace; }\n  .code-area { flex: 1; min-height: 0; display: grid; grid-template-columns: 53px 1fr; overflow: auto; padding: 17px 0 20px; background: #11191f; }\n  .line-numbers { padding-right: 14px; color: #44535b; text-align: right; user-select: none; font: 12px/1.9 'JetBrains Mono', monospace; }\n  .editor-code { overflow: auto; color: #d5dfdf; font: 12px/1.9 'JetBrains Mono', monospace; white-space: pre; }\n  .kw { color: #b49cff; } .fn { color: #79c7ff; } .str { color: #a6e3a1; } .num { color: #f4b942; } .comment { color: #607178; } .var { color: #d5dfdf; }\n  .cursor { display: inline-block; width: 7px; height: 16px; background: var(--green); vertical-align: -3px; animation: blink 1s steps(1) infinite; }\n  @keyframes blink { 0%, 48% { opacity: 1; } 49%, 100% { opacity: 0; } }\n  .results { height: 205px; border-top: 1px solid var(--line); background: #0c1318; overflow: auto; animation: drawer-in .32s cubic-bezier(.22,1,.36,1) both; }\n  @keyframes drawer-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n  .result-head { min-height: 49px; display: flex; align-items: center; gap: 11px; padding: 0 15px; border-bottom: 1px solid var(--line); }\n  .verdict-icon { width: 24px; height: 24px; border: 1px solid rgba(0,255,64,.4); color: var(--green); display: grid; place-items: center; }\n  .verdict-icon i { width: 14px; height: 14px; }\n  .verdict-copy strong { display: block; color: var(--green); font: 600 12px 'JetBrains Mono', monospace; }\n  .verdict-copy span { color: var(--muted); font: 10px 'JetBrains Mono', monospace; }\n  .progress { margin-left: auto; width: 145px; }\n  .progress-label { display: flex; justify-content: space-between; color: var(--muted); font: 9px 'JetBrains Mono', monospace; margin-bottom: 5px; }\n  .progress-track { height: 4px; background: #253139; }\n  .progress-track span { display: block; width: 100%; height: 100%; background: var(--green); }\n  .case-list { padding: 9px 15px 12px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 7px; }\n  .case { border: 1px solid var(--line); background: #10191f; padding: 8px 9px; min-width: 0; }\n  .case.open { border-color: rgba(0,255,64,.42); background: rgba(0,255,64,.035); }\n  .case-top { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font: 9px 'JetBrains Mono', monospace; }\n  .case-top i { width: 11px; height: 11px; color: var(--green); }\n  .case-detail { color: var(--faint); font: 9px/1.55 'JetBrains Mono', monospace; margin-top: 7px; }\n  .actionbar { height: 45px; border-top: 1px solid var(--line); background: #151d22; display: flex; align-items: center; gap: 9px; padding: 0 14px; }\n  .action { border: 1px solid var(--line); background: #0d151a; color: #d7e1e1; padding: 7px 12px; font: 600 10px 'JetBrains Mono', monospace; cursor: pointer; }\n  .action:hover { border-color: var(--green); color: var(--green); }\n  .action.primary { border-color: rgba(0,255,64,.5); color: var(--green); background: rgba(0,255,64,.06); }\n  .run-status { color: var(--muted); font: 10px 'JetBrains Mono', monospace; margin-left: 3px; }\n  .shortcut { margin-left: auto; color: var(--faint); font: 9px 'JetBrains Mono', monospace; }\n  .footerline { height: 25px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; color: var(--faint); background: #071017; font: 9px 'JetBrains Mono', monospace; letter-spacing: .04em; flex-shrink: 0; }\n  .footerline span:last-child { color: #6c7b81; }\n  html.light .arena { --ink: #f3f5f4; --carbon: #fff; --carbon-2: #f8faf9; --panel: #fff; --line: #d9e1df; --line-soft: #e5ece9; --text: #14201d; --muted: #64736e; --faint: #8b9a95; --green: #008f32; --green-soft: rgba(0,143,50,.09); --amber: #a86500; --amber-soft: rgba(168,101,0,.08); background: #f3f5f4; }\n  html.light .topbar, html.light .editor-tabs, html.light .phase-strip, html.light .footerline { background: rgba(255,255,255,.94); }\n  html.light .problem-pane, html.light .editor-pane, html.light .code-area { background: #f7faf8; }\n  html.light .results, html.light .editor-toolbar, html.light .actionbar { background: #fff; }\n  @media (max-width: 900px) { .topbar { padding: 0 12px; gap: 10px; } .brand { min-width: auto; } .brand-sub, .opponent, .warning { display:none; } .workspace { grid-template-columns: 1fr; } .problem-pane { min-height: 440px; border-right: 0; border-bottom: 1px solid var(--line); } .editor-pane { min-height: 640px; } .phase-strip { grid-template-columns: 1fr 1fr; } }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"arena\" data-kid=\"1\" data-name=\"arena main container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity container\">\n            <div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand icon box\">\n                <i data-kid=\"1-1-1-1-1\" data-lucide=\"swords\" data-name=\"sword logo icon\" style=\"width:15px;height:15px;color:var(--green)\">\n                </i>\n            </div>\n            <span class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                DuecIt\n            </span>\n            <span class=\"brand-sub\" data-kid=\"1-1-1-3\" data-name=\"brand subtitle text\">\n                arena / live\n            </span>\n        </div>\n        <div class=\"match-meta\" data-kid=\"1-1-2\" data-name=\"match metadata area\">\n            <span class=\"problem-id mono\" data-kid=\"1-1-2-1\" data-name=\"problem identifier text\">\n                DSA-014\n            </span>\n            <span class=\"problem-name\" data-kid=\"1-1-2-2\" data-name=\"problem name text\">\n                Two Sum\n            </span>\n            <span class=\"divider\" data-kid=\"1-1-2-3\" data-name=\"vertical divider line\">\n            </span>\n            <span class=\"opponent\" data-kid=\"1-1-2-4\" data-name=\"opponent information area\">\n                <span class=\"live-dot\" data-kid=\"1-1-2-4-1\" data-name=\"opponent status indicator dot\">\n                </span>\n                opponent\n                <strong data-kid=\"1-1-2-4-2\" data-name=\"opponent name text\">\n                    alex_k\n                </strong>\n                <span class=\"rating mono\" data-kid=\"1-1-2-4-3\" data-name=\"opponent rating text\">\n                    1798\n                </span>\n            </span>\n        </div>\n        <div class=\"top-actions\" data-kid=\"1-1-3\" data-name=\"header action buttons container\">\n            <div class=\"phase-chip\" data-kid=\"1-1-3-1\" data-name=\"live status chip\">\n                <span class=\"live-dot\" data-dynamic=\"true\" data-kid=\"1-1-3-1-1\" data-name=\"live status indicator dot\" data-reason=\"pulsing animation via CSS\">\n                </span>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"live status label\">\n                    CODE / LIVE\n                </span>\n            </div>\n            <div class=\"timer mono\" data-dynamic=\"true\" data-kid=\"1-1-3-2\" data-name=\"server clock timer\" data-reason=\"text updated via server-side clock data\">\n                <small data-kid=\"1-1-3-2-1\" data-name=\"timer label text\">\n                    SERVER CLOCK\n                </small>\n                08:32\n            </div>\n            <div class=\"warning\" data-kid=\"1-1-3-3\" data-name=\"warning indicator area\">\n                <i data-kid=\"1-1-3-3-1\" data-lucide=\"triangle-alert\" data-name=\"warning alert icon\" style=\"width:13px;height:13px;color:var(--amber)\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"warning count text\">\n                    1\n                </span>\n            </div>\n            <button aria-label=\"Toggle theme\" class=\"theme-toggle\" data-kid=\"1-1-3-4\" data-name=\"theme toggle button\" id=\"theme-toggle\" moon\\\"=\"\" onclick=\"document.documentElement.classList.toggle('light'); this.innerHTML = document.documentElement.classList.contains('light') ? '<i data-lucide=\\\" style='\\\"width:15px;height:15px;color:var(--muted)\\\"'>\n                ' : '\n                <i data-kid=\"1-1-3-4-1\" data-lucide='\\\"sun\\\"' style='\\\"width:15px;height:15px;color:var(--muted)\\\"'>\n                </i>\n                '; lucide.createIcons();\">\n                <i data-kid=\"1-1-3-4-2\" data-lucide=\"sun\" data-name=\"theme toggle sun icon\" style=\"width:15px;height:15px;color:var(--muted)\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <div class=\"phase-strip\" data-kid=\"1-2\" data-name=\"phase indicator strip\">\n        <div class=\"phase-read\" data-kid=\"1-2-1\" data-name=\"read phase status area\">\n            <i data-kid=\"1-2-1-1\" data-lucide=\"lock-keyhole\" data-name=\"read phase lock icon\" style=\"width:12px;height:12px;color:var(--amber)\">\n            </i>\n            <span data-kid=\"1-2-1-2\" data-name=\"read phase label text\">\n                READ PHASE / EDITOR LOCKED\n            </span>\n            <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-1-3\" data-name=\"read phase elapsed timer\" data-reason=\"text updated every second\">\n                00:45 elapsed\n            </span>\n        </div>\n        <div class=\"phase-code\" data-kid=\"1-2-2\" data-name=\"coding phase status area\">\n            <i data-kid=\"1-2-2-1\" data-lucide=\"terminal\" data-name=\"coding phase terminal icon\" style=\"width:12px;height:12px;color:var(--green)\">\n            </i>\n            <span data-kid=\"1-2-2-2\" data-name=\"coding phase label text\">\n                CODING PHASE / LIVE SYNC\n            </span>\n            <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-2-3\" data-name=\"coding phase remaining timer\" data-reason=\"text updated every second\">\n                transition complete · 08:32 remaining\n            </span>\n        </div>\n    </div>\n    <main class=\"workspace\" data-kid=\"1-3\" data-name=\"workspace area\">\n        <section class=\"problem-pane\" data-kid=\"1-3-1\" data-name=\"problem description pane\">\n            <div class=\"problem-head\" data-kid=\"1-3-1-1\" data-name=\"problem header area\">\n                <div class=\"eyebrow mono\" data-kid=\"1-3-1-1-1\" data-name=\"problem eyebrow label\">\n                    problem statement // dsa-014\n                </div>\n                <div class=\"problem-title-row\" data-kid=\"1-3-1-1-2\" data-name=\"problem title row\">\n                    <h1 data-kid=\"1-3-1-1-2-1\" data-name=\"problem title heading\">\n                        Two Sum\n                    </h1>\n                    <span class=\"difficulty\" data-kid=\"1-3-1-1-2-2\" data-name=\"problem difficulty badge\">\n                        easy\n                    </span>\n                </div>\n                <div class=\"tabs\" data-kid=\"1-3-1-1-3\" data-name=\"problem navigation tabs\">\n                    <button class=\"tab active\" data-kid=\"1-3-1-1-3-1\" data-name=\"problem tab button\">\n                        Problem\n                    </button>\n                    <button class=\"tab\" data-kid=\"1-3-1-1-3-2\" data-name=\"IO format tab button\">\n                        I/O Format\n                    </button>\n                </div>\n            </div>\n            <article class=\"article\" data-kid=\"1-3-1-2\" data-name=\"problem article content\">\n                <div class=\"section-label\" data-kid=\"1-3-1-2-1\" data-name=\"description section label\">\n                    Description\n                </div>\n                <p data-kid=\"1-3-1-2-2\" data-name=\"description text paragraph\">\n                    Given an array of integers\n                    <code data-kid=\"1-3-1-2-2-1\" data-name=\"nums code snippet\">\n                        nums\n                    </code>\n                    and an integer\n                    <code data-kid=\"1-3-1-2-2-2\" data-name=\"target code snippet\">\n                        target\n                    </code>\n                    , return the indices of the two numbers such that they add up to\n                    <code data-kid=\"1-3-1-2-2-3\" data-name=\"target code snippet\">\n                        target\n                    </code>\n                    .\n                </p>\n                <p data-kid=\"1-3-1-2-3\" data-name=\"instructions text paragraph\">\n                    You may assume that each input has exactly one solution, and you may not use the same element twice. Return the answer in any order.\n                </p>\n                <div class=\"section-label\" data-kid=\"1-3-1-2-4\" data-name=\"constraints section label\">\n                    Constraints\n                </div>\n                <div class=\"constraint\" data-kid=\"1-3-1-2-5\" data-name=\"constraints box\">\n                    <b data-kid=\"1-3-1-2-5-1\" data-name=\"constraints header\">\n                        INPUT BOUNDS\n                    </b>\n                    2 ≤ nums.length ≤ 10⁴\n                    <br data-kid=\"1-3-1-2-5-2\" data-name=\"line break\"/>\n                    −10⁹ ≤ nums[i] ≤ 10⁹\n                    <br data-kid=\"1-3-1-2-5-3\" data-name=\"line break\"/>\n                    −10⁹ ≤ target ≤ 10⁹\n                </div>\n                <div class=\"section-label\" data-kid=\"1-3-1-2-6\" data-name=\"examples section label\">\n                    Examples\n                </div>\n                <div class=\"sample\" data-kid=\"1-3-1-2-7\" data-name=\"example one container\">\n                    <div class=\"sample-head\" data-kid=\"1-3-1-2-7-1\" data-name=\"example one header\">\n                        <span data-kid=\"1-3-1-2-7-1-1\" data-name=\"example one title\">\n                            example 01\n                        </span>\n                        <span data-kid=\"1-3-1-2-7-1-2\" data-name=\"example one expected type\">\n                            expected / exact\n                        </span>\n                    </div>\n                    <div class=\"sample-grid\" data-kid=\"1-3-1-2-7-2\" data-name=\"example one grid\">\n                        <div class=\"sample-cell\" data-kid=\"1-3-1-2-7-2-1\" data-name=\"example one input cell\">\n                            <small data-kid=\"1-3-1-2-7-2-1-1\" data-name=\"example one input label\">\n                                input\n                            </small>\n                            <pre data-kid=\"1-3-1-2-7-2-1-2\" data-name=\"example one input code\">nums = [2, 7, 11, 15]\ntarget = 9</pre>\n                        </div>\n                        <div class=\"sample-cell\" data-kid=\"1-3-1-2-7-2-2\" data-name=\"example one output cell\">\n                            <small data-kid=\"1-3-1-2-7-2-2-1\" data-name=\"example one output label\">\n                                output\n                            </small>\n                            <pre data-kid=\"1-3-1-2-7-2-2-2\" data-name=\"example one output code\">[0, 1]</pre>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"sample\" data-kid=\"1-3-1-2-8\" data-name=\"example two container\">\n                    <div class=\"sample-head\" data-kid=\"1-3-1-2-8-1\" data-name=\"example two header\">\n                        <span data-kid=\"1-3-1-2-8-1-1\" data-name=\"example two title\">\n                            example 02\n                        </span>\n                        <span data-kid=\"1-3-1-2-8-1-2\" data-name=\"example two expected type\">\n                            expected / exact\n                        </span>\n                    </div>\n                    <div class=\"sample-grid\" data-kid=\"1-3-1-2-8-2\" data-name=\"example two grid\">\n                        <div class=\"sample-cell\" data-kid=\"1-3-1-2-8-2-1\" data-name=\"example two input cell\">\n                            <small data-kid=\"1-3-1-2-8-2-1-1\" data-name=\"example two input label\">\n                                input\n                            </small>\n                            <pre data-kid=\"1-3-1-2-8-2-1-2\" data-name=\"example two input code\">nums = [3, 2, 4]\ntarget = 6</pre>\n                        </div>\n                        <div class=\"sample-cell\" data-kid=\"1-3-1-2-8-2-2\" data-name=\"example two output cell\">\n                            <small data-kid=\"1-3-1-2-8-2-2-1\" data-name=\"example two output label\">\n                                output\n                            </small>\n                            <pre data-kid=\"1-3-1-2-8-2-2-2\" data-name=\"example two output code\">[1, 2]</pre>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"hint\" data-kid=\"1-3-1-2-9\" data-name=\"hint section\">\n                    <b data-kid=\"1-3-1-2-9-1\" data-name=\"hint header\">\n                        FUNCTION MODE\n                    </b>\n                    <br data-kid=\"1-3-1-2-9-2\" data-name=\"line break\"/>\n                    Write only\n                    <code data-kid=\"1-3-1-2-9-3\" data-name=\"function name code\">\n                        two_sum(nums, target)\n                    </code>\n                    . The hidden driver handles input/output. No stdin. No print.\n                </div>\n            </article>\n        </section>\n        <section class=\"editor-pane\" data-kid=\"1-3-2\" data-name=\"code editor pane\">\n            <div class=\"editor-tabs\" data-kid=\"1-3-2-1\" data-name=\"editor tab bar\">\n                <div class=\"file-tab active\" data-kid=\"1-3-2-1-1\" data-name=\"solution file tab\">\n                    <i data-kid=\"1-3-2-1-1-1\" data-lucide=\"file-code-2\" data-name=\"solution file icon\" style=\"width:13px;height:13px;color:var(--green)\">\n                    </i>\n                    <span data-kid=\"1-3-2-1-1-2\" data-name=\"solution file name\">\n                        solution.py\n                    </span>\n                </div>\n                <div class=\"file-tab\" data-kid=\"1-3-2-1-2\" data-name=\"tests file tab\">\n                    <i data-kid=\"1-3-2-1-2-1\" data-lucide=\"file-terminal\" data-name=\"tests file icon\" style=\"width:13px;height:13px;color:var(--faint)\">\n                    </i>\n                    <span data-kid=\"1-3-2-1-2-2\" data-name=\"tests file name\">\n                        tests\n                    </span>\n                </div>\n                <div class=\"editor-meta\" data-kid=\"1-3-2-1-3\" data-name=\"editor metadata area\">\n                    <span class=\"opponent-progress\" data-kid=\"1-3-2-1-3-1\" data-name=\"opponent progress text\">\n                        opponent / 6 lines\n                    </span>\n                    <span data-kid=\"1-3-2-1-3-2\" data-name=\"autosave status text\">\n                        autosave: on\n                    </span>\n                </div>\n            </div>\n            <div class=\"editor-toolbar\" data-kid=\"1-3-2-2\" data-name=\"editor toolbar\">\n                <span class=\"select-like\" data-kid=\"1-3-2-2-1\" data-name=\"language selection dropdown\">\n                    <i data-kid=\"1-3-2-2-1-1\" data-lucide=\"braces\" data-name=\"code icon\" style=\"width:12px;height:12px;color:var(--green)\">\n                    </i>\n                    Python 3\n                    <i data-kid=\"1-3-2-2-1-2\" data-lucide=\"chevron-down\" data-name=\"chevron icon\" style=\"width:12px;height:12px;color:var(--faint)\">\n                    </i>\n                </span>\n                <span class=\"lock-note mono\" data-kid=\"1-3-2-2-2\" data-name=\"sync status label\">\n                    ● synced / no paste / rated\n                </span>\n            </div>\n            <div class=\"code-area\" data-kid=\"1-3-2-3\" data-name=\"code editor area\">\n                <div class=\"line-numbers\" data-kid=\"1-3-2-3-1\" data-name=\"line numbers column\">\n                    1\n                    <br data-kid=\"1-3-2-3-1-1\" data-name=\"line number break\"/>\n                    2\n                    <br data-kid=\"1-3-2-3-1-2\"/>\n                    3\n                    <br data-kid=\"1-3-2-3-1-3\"/>\n                    4\n                    <br data-kid=\"1-3-2-3-1-4\"/>\n                    5\n                    <br data-kid=\"1-3-2-3-1-5\"/>\n                    6\n                    <br data-kid=\"1-3-2-3-1-6\"/>\n                    7\n                    <br data-kid=\"1-3-2-3-1-7\"/>\n                    8\n                    <br data-kid=\"1-3-2-3-1-8\"/>\n                    9\n                    <br data-kid=\"1-3-2-3-1-9\"/>\n                    10\n                    <br data-kid=\"1-3-2-3-1-10\"/>\n                    11\n                    <br data-kid=\"1-3-2-3-1-11\"/>\n                    12\n                </div>\n                <pre class=\"editor-code\" data-kid=\"1-3-2-3-2\" data-name=\"editor code content\"><span class=\"kw\" data-kid=\"1-3-2-3-2-1\" data-name=\"code keyword span\">def</span> <span class=\"fn\" data-kid=\"1-3-2-3-2-2\" data-name=\"code function span\">two_sum</span>(<span class=\"var\" data-kid=\"1-3-2-3-2-3\" data-name=\"code variable span\">nums</span>, <span class=\"var\" data-kid=\"1-3-2-3-2-4\" data-name=\"code variable span\">target</span>):\n    <span class=\"comment\" data-kid=\"1-3-2-3-2-5\" data-name=\"code comment span\"># O(n) lookup; return indices, not values</span>\n    <span class=\"var\" data-kid=\"1-3-2-3-2-6\" data-name=\"code variable span\">seen</span> = {}\n\n    <span class=\"kw\" data-kid=\"1-3-2-3-2-7\" data-name=\"code keyword span\">for</span> <span class=\"var\" data-kid=\"1-3-2-3-2-8\" data-name=\"code variable span\">i</span>, <span class=\"var\" data-kid=\"1-3-2-3-2-9\" data-name=\"code variable span\">value</span> <span class=\"kw\" data-kid=\"1-3-2-3-2-10\" data-name=\"code keyword span\">in</span> <span class=\"fn\" data-kid=\"1-3-2-3-2-11\" data-name=\"code function span\">enumerate</span>(<span class=\"var\" data-kid=\"1-3-2-3-2-12\" data-name=\"code variable span\">nums</span>):\n        <span class=\"var\" data-kid=\"1-3-2-3-2-13\" data-name=\"code variable span\">complement</span> = <span class=\"var\" data-kid=\"1-3-2-3-2-14\" data-name=\"code variable span\">target</span> - <span class=\"var\" data-kid=\"1-3-2-3-2-15\" data-name=\"code variable span\">value</span>\n        <span class=\"kw\" data-kid=\"1-3-2-3-2-16\" data-name=\"code keyword span\">if</span> <span class=\"var\" data-kid=\"1-3-2-3-2-17\" data-name=\"code variable span\">complement</span> <span class=\"kw\" data-kid=\"1-3-2-3-2-18\" data-name=\"code keyword span\">in</span> <span class=\"var\" data-kid=\"1-3-2-3-2-19\" data-name=\"code variable span\">seen</span>:\n            <span class=\"kw\" data-kid=\"1-3-2-3-2-20\" data-name=\"code keyword span\">return</span> [<span class=\"var\" data-kid=\"1-3-2-3-2-21\" data-name=\"code variable span\">seen</span>[<span class=\"var\" data-kid=\"1-3-2-3-2-22\" data-name=\"code variable span\">complement</span>], <span class=\"var\" data-kid=\"1-3-2-3-2-23\" data-name=\"code variable span\">i</span>]\n        <span class=\"var\" data-kid=\"1-3-2-3-2-24\" data-name=\"code variable span\">seen</span>[<span class=\"var\" data-kid=\"1-3-2-3-2-25\" data-name=\"code variable span\">value</span>] = <span class=\"var\" data-kid=\"1-3-2-3-2-26\" data-name=\"code variable span\">i</span>\n\n    <span class=\"kw\" data-kid=\"1-3-2-3-2-27\" data-name=\"code keyword span\">return</span> []<span class=\"cursor\" data-dynamic=\"true\" data-kid=\"1-3-2-3-2-28\" data-name=\"code cursor element\" data-reason=\"blinking animation via CSS\"></span></pre>\n            </div>\n            <div class=\"results\" data-kid=\"1-3-2-4\" data-name=\"results drawer\">\n                <div class=\"result-head\" data-kid=\"1-3-2-4-1\" data-name=\"results header\">\n                    <div class=\"verdict-icon\" data-kid=\"1-3-2-4-1-1\" data-name=\"verdict icon container\">\n                        <i data-kid=\"1-3-2-4-1-1-1\" data-lucide=\"check\" data-name=\"verdict check icon\" style=\"width:14px;height:14px;color:var(--green)\">\n                        </i>\n                    </div>\n                    <div class=\"verdict-copy\" data-kid=\"1-3-2-4-1-2\" data-name=\"verdict label text area\">\n                        <strong data-dynamic=\"true\" data-kid=\"1-3-2-4-1-2-1\" data-name=\"verdict label text\" data-reason=\"text updated by test runner\">\n                            Accepted\n                        </strong>\n                        <span data-kid=\"1-3-2-4-1-2-2\" data-name=\"verdict stats text\">\n                            sample cases / 4 of 4 passed · 18ms\n                        </span>\n                    </div>\n                    <div class=\"progress\" data-kid=\"1-3-2-4-1-3\" data-name=\"progress bar container\">\n                        <div class=\"progress-label\" data-kid=\"1-3-2-4-1-3-1\" data-name=\"progress header\">\n                            <span data-kid=\"1-3-2-4-1-3-1-1\" data-name=\"progress label text\">\n                                sample progress\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-4-1-3-1-2\" data-name=\"progress percentage text\" data-reason=\"text updated by test runner\">\n                                100%\n                            </span>\n                        </div>\n                        <div class=\"progress-track\" data-kid=\"1-3-2-4-1-3-2\" data-name=\"progress track\">\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-4-1-3-2-1\" data-name=\"progress bar fill\" data-reason=\"width updated by test runner\">\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"case-list\" data-kid=\"1-3-2-4-2\" data-name=\"test case list\">\n                    <div class=\"case open\" data-kid=\"1-3-2-4-2-1\" data-name=\"test case one\">\n                        <div class=\"case-top\" data-kid=\"1-3-2-4-2-1-1\" data-name=\"test case one top row\">\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-4-2-1-1-1\" data-name=\"test case one status text\" data-reason=\"updated by test runner\">\n                                case 01 · passed\n                            </span>\n                            <i data-kid=\"1-3-2-4-2-1-1-2\" data-lucide=\"chevron-down\" data-name=\"test case one chevron icon\" style=\"width:11px;height:11px;color:var(--green)\">\n                            </i>\n                        </div>\n                        <div class=\"case-detail\" data-kid=\"1-3-2-4-2-1-2\" data-name=\"test case one details\">\n                            input [2,7,11,15] / 9\n                            <br data-kid=\"1-3-2-4-2-1-2-1\" data-name=\"details line break\"/>\n                            expected [0,1] · 4ms\n                        </div>\n                    </div>\n                    <div class=\"case\" data-kid=\"1-3-2-4-2-2\" data-name=\"test case two\">\n                        <div class=\"case-top\" data-kid=\"1-3-2-4-2-2-1\" data-name=\"test case two top row\">\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-4-2-2-1-1\" data-name=\"test case two status text\" data-reason=\"updated by test runner\">\n                                case 02 · passed\n                            </span>\n                            <i data-kid=\"1-3-2-4-2-2-1-2\" data-lucide=\"chevron-right\" data-name=\"test case two chevron icon\" style=\"width:11px;height:11px;color:var(--green)\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"case\" data-kid=\"1-3-2-4-2-3\" data-name=\"test case three\">\n                        <div class=\"case-top\" data-kid=\"1-3-2-4-2-3-1\" data-name=\"test case three top row\">\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-4-2-3-1-1\" data-name=\"test case three status text\" data-reason=\"updated by test runner\">\n                                case 03 · passed\n                            </span>\n                            <i data-kid=\"1-3-2-4-2-3-1-2\" data-lucide=\"chevron-right\" data-name=\"test case three chevron icon\" style=\"width:11px;height:11px;color:var(--green)\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"actionbar\" data-kid=\"1-3-2-5\" data-name=\"action bar\">\n                <button class=\"action mono\" data-kid=\"1-3-2-5-1\" data-name=\"run samples button\">\n                    > run_samples\n                </button>\n                <button class=\"action primary mono\" data-kid=\"1-3-2-5-2\" data-name=\"submit button\">\n                    > submit\n                </button>\n                <span class=\"run-status mono\" data-dynamic=\"true\" data-kid=\"1-3-2-5-3\" data-name=\"run status message\" data-reason=\"updated by test runner\">\n                    judge ready / last run 18ms\n                </span>\n                <span class=\"shortcut mono\" data-kid=\"1-3-2-5-4\" data-name=\"keyboard shortcut text\">\n                    ⌘ ↵ submit\n                </span>\n            </div>\n        </section>\n    </main>\n    <footer class=\"footerline\" data-kid=\"1-4\" data-name=\"footer section\">\n        <span data-dynamic=\"true\" data-kid=\"1-4-1\" data-name=\"footer session status text\" data-reason=\"updated dynamically based on session\">\n            match / 8F31A2 · secure session · tab warnings 1/3\n        </span>\n        <span data-kid=\"1-4-2\" data-name=\"footer brand text\">\n            DuecIt // every match is a lesson\n        </span>\n    </footer>\n</div>\n<script>\n    lucide.createIcons();\n</script>\n",
