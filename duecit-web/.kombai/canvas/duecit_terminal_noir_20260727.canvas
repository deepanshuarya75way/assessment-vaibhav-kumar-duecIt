            </span>\n                        <span data-kid=\"1-2-1-1-1-2-3\" data-name=\"hero headline line break\" style=\"color:var(--tn-line)\">\n                            ·\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-2-4\">\n                            no spectators mode\n                        </span>\n                    </div>\n                </div>\n                <div class=\"tn-visual\" data-kid=\"1-2-1-1-2\">\n                    <div aria-label=\"Live coding duel preview\" class=\"tn-terminal\" data-kid=\"1-2-1-1-2-1\">\n                        <div class=\"tn-terminal-top\" data-kid=\"1-2-1-1-2-1-1\">\n                            <span class=\"tn-terminal-dots\" data-kid=\"1-2-1-1-2-1-1-1\">\n                                <span data-kid=\"1-2-1-1-2-1-1-1-1\">\n                                </span>\n                                <span data-kid=\"1-2-1-1-2-1-1-1-2\">\n                                </span>\n                                <span data-kid=\"1-2-1-1-2-1-1-1-3\">\n                                </span>\n                            </span>\n                            <span class=\"tn-terminal-file\" data-kid=\"1-2-1-1-2-1-1-2\">\n                                solution.py\n                            </span>\n                            <span class=\"tn-terminal-live\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-1-3\" data-name=\"live indicator badge\" data-reason=\"'LIVE' status indicator updated by script\">\n                                <span class=\"tn-live-dot\" data-kid=\"1-2-1-1-2-1-1-3-1\">\n                                </span>\n                                LIVE / MATCH 8F31\n                            </span>\n                        </div>\n                        <div class=\"tn-terminal-body\" data-kid=\"1-2-1-1-2-1-2\">\n                            <section class=\"tn-editor\" data-kid=\"1-2-1-1-2-1-2-1\">\n                                <div class=\"tn-pane-label\" data-kid=\"1-2-1-1-2-1-2-1-1\">\n                                    <strong data-kid=\"1-2-1-1-2-1-2-1-1-1\">\n                                        you / python 3\n                                    </strong>\n                                    <span data-kid=\"1-2-1-1-2-1-2-1-1-2\">\n                                        coding\n                                    </span>\n                                </div>\n                                <div class=\"tn-code\" data-kid=\"1-2-1-1-2-1-2-1-2\">\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-1\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-1-1\">\n                                            01\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-1-2\">\n                                            <span class=\"tn-kw\" data-kid=\"1-2-1-1-2-1-2-1-2-1-2-1\">\n                                                def\n                                            </span>\n                                            <span class=\"tn-fn\" data-kid=\"1-2-1-1-2-1-2-1-2-1-2-2\">\n                                                two_sum\n                                            </span>\n                                            (nums, target):\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-2\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-2-1\">\n                                            02\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-2-2\">\n                                            seen = {}\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-3\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-3-1\">\n                                            03\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-3-2\">\n                                            <span class=\"tn-kw\" data-kid=\"1-2-1-1-2-1-2-1-2-3-2-1\">\n                                                for\n                                            </span>\n                                            i, value\n                                            <span class=\"tn-kw\" data-kid=\"1-2-1-1-2-1-2-1-2-3-2-2\">\n                                                in\n                                            </span>\n                                            <span class=\"tn-fn\" data-kid=\"1-2-1-1-2-1-2-1-2-3-2-3\">\n                                                enumerate\n                                            </span>\n                                            (nums):\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-4\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-4-1\">\n                                            04\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-4-2\">\n                                            complement = target - value\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-5\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-5-1\">\n                                            05\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-5-2\">\n                                            <span class=\"tn-kw\" data-kid=\"1-2-1-1-2-1-2-1-2-5-2-1\">\n                                                if\n                                            </span>\n                                            complement\n                                            <span class=\"tn-kw\" data-kid=\"1-2-1-1-2-1-2-1-2-5-2-2\">\n                                                in\n                                            </span>\n                                            seen:\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-6\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-6-1\">\n                                            06\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-6-2\">\n                                            <span class=\"tn-kw\" data-kid=\"1-2-1-1-2-1-2-1-2-6-2-1\">\n                                                return\n                                            </span>\n                                            [seen[complement], i]\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-7\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-7-1\">\n                                            07\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-7-2\">\n                                            seen[value] = i\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-8\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-8-1\">\n                                            08\n                                        </span>\n                                        <span class=\"tn-cm\" data-kid=\"1-2-1-1-2-1-2-1-2-8-2\">\n                                            # hidden tests will judge the rest\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-code-line\" data-kid=\"1-2-1-1-2-1-2-1-2-9\">\n                                        <span class=\"tn-ln\" data-kid=\"1-2-1-1-2-1-2-1-2-9-1\">\n                                            09\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-1-2-9-2\">\n                                            <span class=\"tn-blink\" data-kid=\"1-2-1-1-2-1-2-1-2-9-2-1\">\n                                            </span>\n                                        </span>\n                                    </div>\n                                </div>\n                            </section>\n                            <section class=\"tn-opponent\" data-kid=\"1-2-1-1-2-1-2-2\">\n                                <div class=\"tn-pane-label\" data-kid=\"1-2-1-1-2-1-2-2-1\">\n                                    <strong data-kid=\"1-2-1-1-2-1-2-2-1-1\">\n                                        opponent / progress\n                                    </strong>\n                                    <span data-kid=\"1-2-1-1-2-1-2-2-1-2\">\n                                        server sync\n                                    </span>\n                                </div>\n                                <div class=\"tn-opponent-top\" data-kid=\"1-2-1-1-2-1-2-2-2\" style=\"margin-top:18px\">\n                                    <div class=\"tn-player\" data-kid=\"1-2-1-1-2-1-2-2-2-1\">\n                                        <span class=\"tn-avatar\" data-kid=\"1-2-1-1-2-1-2-2-2-1-1\">\n                                            AK\n                                        </span>\n                                        <span data-kid=\"1-2-1-1-2-1-2-2-2-1-2\">\n                                            alex_k\n                                        </span>\n                                    </div>\n                                    <span class=\"tn-rating\" data-kid=\"1-2-1-1-2-1-2-2-2-2\">\n                                        1847 ELO\n                                    </span>\n                                </div>\n                                <div class=\"tn-opponent-status\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2-2-3\" data-name=\"opponent status text\" data-reason=\"status message updated based on opponent activity\">\n                                    <span class=\"tn-live-dot\" data-kid=\"1-2-1-1-2-1-2-2-3-1\" style=\"display:inline-block;margin-right:7px\">\n                                    </span>\n                                    opponent is coding…\n                                </div>\n                                <div class=\"tn-mini-stat\" data-kid=\"1-2-1-1-2-1-2-2-4\">\n                                    <span data-kid=\"1-2-1-1-2-1-2-2-4-1\">\n                                        last signal\n                                    </span>\n                                    <strong data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2-2-4-2\" data-name=\"last signal timestamp text\" data-reason=\"timestamp updated every few seconds by script\">\n                                        18 sec ago\n                                    </strong>\n                                </div>\n                                <div class=\"tn-mini-stat\" data-kid=\"1-2-1-1-2-1-2-2-5\">\n                                    <span data-kid=\"1-2-1-1-2-1-2-2-5-1\">\n                                        submission\n                                    </span>\n                                    <strong data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2-2-5-2\" data-name=\"submission status text\" data-reason=\"status text updated based on server response\">\n                                        pending\n                                    </strong>\n                                </div>\n                                <div class=\"tn-mini-stat\" data-kid=\"1-2-1-1-2-1-2-2-6\">\n                                    <span data-kid=\"1-2-1-1-2-1-2-2-6-1\">\n                                        match mode\n                                    </span>\n                                    <strong data-kid=\"1-2-1-1-2-1-2-2-6-2\">\n                                        competitive\n                                    </strong>\n                                </div>\n                                <div aria-hidden=\"true\" class=\"tn-sparkline\" data-kid=\"1-2-1-1-2-1-2-2-7\">\n                                    <svg data-kid=\"1-2-1-1-2-1-2-2-7-1\" preserveaspectratio=\"none\" viewbox=\"0 0 240 70\">\n                                        <path d=\"M0 57 L26 52 L52 55 L76 42 L103 46 L128 27 L152 34 L178 19 L204 24 L240 9\">\n                                        </path>\n                                    </svg>\n                                </div>\n                                <div class=\"tn-judge\" data-kid=\"1-2-1-1-2-1-2-2-8\">\n                                    <div class=\"tn-judge-label\" data-kid=\"1-2-1-1-2-1-2-2-8-1\">\n                                        <span data-kid=\"1-2-1-1-2-1-2-2-8-1-1\">\n                                            sample judge\n                                        </span>\n                                        <span data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2-2-8-1-2\" data-name=\"sample judge score text\" data-reason=\"score updated as test cases run\" style=\"color:var(--tn-green)\">\n                                            42 / 50\n                                        </span>\n                                    </div>\n                                    <div class=\"tn-progress\" data-kid=\"1-2-1-1-2-1-2-2-8-2\">\n                                        <span data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2-2-8-2-1\" data-name=\"sample judge progress bar fill\" data-reason=\"width percentage updated based on test progress\">\n                                        </span>\n                                    </div>\n                                </div>\n                            </section>\n                        </div>\n                        <div class=\"tn-vs-strip\" data-kid=\"1-2-1-1-2-1-3\">\n                            <span data-kid=\"1-2-1-1-2-1-3-1\">\n                                you\n                                <b data-kid=\"1-2-1-1-2-1-3-1-1\" style=\"color:#D8E2E5;font-weight:500\">\n                                    @candidate\n                                </b>\n                            </span>\n                            <span class=\"tn-vs\" data-kid=\"1-2-1-1-2-1-3-2\">\n                                VS\n                            </span>\n                            <span data-kid=\"1-2-1-1-2-1-3-3\">\n                                <b data-kid=\"1-2-1-1-2-1-3-3-1\" style=\"color:#D8E2E5;font-weight:500\">\n                                    @alex_k\n                                </b>\n                                opponent\n                            </span>\n                        </div>\n                        <div class=\"tn-terminal-bottom\" data-kid=\"1-2-1-1-2-1-4\">\n                            <span class=\"tn-terminal-result\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-4-1\" data-name=\"terminal status message text\" data-reason=\"result text updated after code submission\">\n                                <i aria-hidden=\"true\" data-kid=\"1-2-1-1-2-1-4-1-1\" data-lucide=\"check-circle-2\">\n                                </i>\n                                Accepted — 47/47 sample cases\n                            </span>\n                            <span class=\"tn-timer\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-4-2\" data-name=\"terminal timer display\" data-reason=\"time elapsed updated every second\">\n                                <small data-kid=\"1-2-1-1-2-1-4-2-1\">\n                                    CODE\n                                </small>\n                                08:32\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"tn-proof\" data-kid=\"1-2-1-2\">\n                <div class=\"tn-proof-item\" data-kid=\"1-2-1-2-1\">\n                    <span class=\"tn-proof-key\" data-kid=\"1-2-1-2-1-1\">\n                        $\n                    </span>\n                    <div class=\"tn-proof-copy\" data-kid=\"1-2-1-2-1-2\">\n                        <strong data-kid=\"1-2-1-2-1-2-1\">\n                            the protocol is simple\n                        </strong>\n                        performance over posturing\n                    </div>\n                </div>\n                <div class=\"tn-proof-item\" data-kid=\"1-2-1-2-2\">\n                    <span class=\"tn-proof-key\" data-kid=\"1-2-1-2-2-1\">\n                        01\n                    </span>\n                    <div class=\"tn-proof-copy\" data-kid=\"1-2-1-2-2-2\">\n                        <strong data-kid=\"1-2-1-2-2-2-1\">\n                            ELO matchmaking\n                        </strong>\n                        ±200 rating window\n                    </div>\n                </div>\n                <div class=\"tn-proof-item\" data-kid=\"1-2-1-2-3\">\n                    <span class=\"tn-proof-key\" data-kid=\"1-2-1-2-3-1\">\n                        02\n                    </span>\n                    <div class=\"tn-proof-copy\" data-kid=\"1-2-1-2-3-2\">\n                        <strong data-kid=\"1-2-1-2-3-2-1\">\n                            hidden test cases\n                        </strong>\n                        server-side judging\n                    </div>\n                </div>\n                <div class=\"tn-proof-item\" data-kid=\"1-2-1-2-4\">\n                    <span class=\"tn-proof-key\" data-kid=\"1-2-1-2-4-1\">\n                        03\n                    </span>\n                    <div class=\"tn-proof-copy\" data-kid=\"1-2-1-2-4-2\">\n                        <strong data-kid=\"1-2-1-2-4-2-1\">\n                            45s read / 10m code\n                        </strong>\n                        same clock, same problem\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"tn-section tn-shell\" data-kid=\"1-2-2\" id=\"protocol\">\n            <div class=\"tn-section-head\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <div class=\"tn-kicker\" data-kid=\"1-2-2-1-1-1\">\n                        / protocol\n                    </div>\n                    <h2 class=\"tn-section-title\" data-kid=\"1-2-2-1-1-2\">\n                        Four commands.\n                        <br data-kid=\"1-2-2-1-1-2-1\"/>\n                        One honest result.\n                    </h2>\n                </div>\n                <p class=\"tn-section-note\" data-kid=\"1-2-2-1-2\">\n                    No feed to scroll. No AI to prompt. Pick a problem, meet your opponent, and let the judge decide what the code can do.\n                </p>\n            </div>\n            <div class=\"tn-process\" data-kid=\"1-2-2-2\" style=\"margin-top:28px\">\n                <div class=\"tn-process-step\" data-kid=\"1-2-2-2-1\">\n                    <span class=\"tn-step-no\" data-kid=\"1-2-2-2-1-1\">\n                        01 / queue\n                    </span>\n                    <h3 class=\"tn-step-title\" data-kid=\"1-2-2-2-1-2\">\n                        Find a match\n                    </h3>\n                    <p class=\"tn-step-body\" data-kid=\"1-2-2-2-1-3\">\n                        Choose category, difficulty, and mode. Matchmaking keeps the field close.\n                    </p>\n                </div>\n                <div class=\"tn-process-step\" data-kid=\"1-2-2-2-2\">\n                    <span class=\"tn-step-no\" data-kid=\"1-2-2-2-2-1\">\n                        02 / read\n                    </span>\n                    <h3 class=\"tn-step-title\" data-kid=\"1-2-2-2-2-2\">\n                        Read the problem\n                    </h3>\n                    <p class=\"tn-step-body\" data-kid=\"1-2-2-2-2-3\">\n                        Both engineers get the same statement and a shared 45 second read phase.\n                    </p>\n                </div>\n                <div class=\"tn-process-step\" data-kid=\"1-2-2-2-3\">\n                    <span class=\"tn-step-no\" data-kid=\"1-2-2-2-3-1\">\n                        03 / code\n                    </span>\n                    <h3 class=\"tn-step-title\" data-kid=\"1-2-2-2-3-2\">\n                        Write your solution\n                    </h3>\n                    <p class=\"tn-step-body\" data-kid=\"1-2-2-2-3-3\">\n                        Use the editor you know. Run samples, watch the clock, stay in the arena.\n                    </p>\n                </div>\n                <div class=\"tn-process-step\" data-kid=\"1-2-2-2-4\">\n                    <span class=\"tn-step-no\" data-kid=\"1-2-2-2-4-1\">\n                        04 / judge\n                    </span>\n                    <h3 class=\"tn-step-title\" data-kid=\"1-2-2-2-4-2\">\n                        Earn the delta\n                    </h3>\n                    <p class=\"tn-step-body\" data-kid=\"1-2-2-2-4-3\">\n                        Hidden cases run server-side. Win, learn, and let your ELO reflect it.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"tn-section tn-shell\" data-kid=\"1-2-3\" id=\"leaderboard\" style=\"padding-top:0\">\n            <div class=\"tn-protocol\" data-kid=\"1-2-3-1\">\n                <div class=\"tn-protocol-copy\" data-kid=\"1-2-3-1-1\">\n                    <div class=\"tn-kicker\" data-kid=\"1-2-3-1-1-1\">\n                        / system readout\n                    </div>\n                    <h2 class=\"tn-section-title\" data-kid=\"1-2-3-1-1-2\" style=\"margin-top:14px\">\n                        Built for engineers.\n                        <br data-kid=\"1-2-3-1-1-2-1\"/>\n                        Not spectators.\n                    </h2>\n                    <p data-kid=\"1-2-3-1-1-3\">\n                        DuecIt is deliberately small, fast, and a little opinionated. The interface stays quiet so the problem, the code, and the other person stay loud.\n                    </p>\n                    <div class=\"tn-protocol-code\" data-kid=\"1-2-3-1-1-4\">\n                        <span data-kid=\"1-2-3-1-1-4-1\">\n                            const\n                        </span>\n                        focus =\n                        <span data-kid=\"1-2-3-1-1-4-2\">\n                            true\n                        </span>\n                        ;\n                        <br data-kid=\"1-2-3-1-1-4-3\"/>\n                        <span data-kid=\"1-2-3-1-1-4-4\">\n                            const\n                        </span>\n                        excuses =\n                        <span data-kid=\"1-2-3-1-1-4-5\">\n                            false\n                        </span>\n                        ;\n                    </div>\n                </div>\n                <div class=\"tn-protocol-list\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"tn-readout\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"tn-readout-label\" data-kid=\"1-2-3-1-2-1-1\">\n                            matchmaking.window\n                        </span>\n                        <span class=\"tn-readout-value green\" data-kid=\"1-2-3-1-2-1-2\">\n                            ±200 ELO\n                        </span>\n                    </div>\n                    <div class=\"tn-readout\" data-kid=\"1-2-3-1-2-2\">\n                        <span class=\"tn-readout-label\" data-kid=\"1-2-3-1-2-2-1\">\n                            judge.visibility\n                        </span>\n                        <span class=\"tn-readout-value\" data-kid=\"1-2-3-1-2-2-2\">\n                            hidden tests\n                        </span>\n                    </div>\n                    <div class=\"tn-readout\" data-kid=\"1-2-3-1-2-3\">\n                        <span class=\"tn-readout-label\" data-kid=\"1-2-3-1-2-3-1\">\n                            duel.clock\n                        </span>\n                        <span class=\"tn-readout-value\" data-kid=\"1-2-3-1-2-3-2\">\n                            00:45 + 10:00\n                        </span>\n                    </div>\n                    <div class=\"tn-readout\" data-kid=\"1-2-3-1-2-4\">\n                        <span class=\"tn-readout-label\" data-kid=\"1-2-3-1-2-4-1\">\n                            practice.mode\n                        </span>\n                        <span class=\"tn-readout-value\" data-kid=\"1-2-3-1-2-4-2\">\n                            one focused attempt\n                        </span>\n                    </div>\n                    <div class=\"tn-readout\" data-kid=\"1-2-3-1-2-5\">\n                        <span class=\"tn-readout-label\" data-kid=\"1-2-3-1-2-5-1\">\n                            rating.delta\n                        </span>\n                        <span class=\"tn-readout-value green\" data-kid=\"1-2-3-1-2-5-2\">\n                            server-calculated\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"tn-section tn-shell\" data-kid=\"1-2-4\" id=\"join\" style=\"padding-top:0\">\n            <div class=\"tn-section-rule\" data-kid=\"1-2-4-1\" style=\"padding-top:26px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap\">\n                <span class=\"tn-kicker\" data-kid=\"1-2-4-1-1\">\n                    / ready state\n                </span>\n                <span data-kid=\"1-2-4-1-2\" style=\"color:var(--tn-muted);font-size:11px\">\n                    new opponents are waiting in the queue\n                </span>\n                <a class=\"tn-cta\" data-kid=\"1-2-4-1-3\" href=\"#top\">\n                    <span class=\"tn-cta-prompt\" data-kid=\"1-2-4-1-3-1\">\n                        >\n                    </span>\n                    start_first_duel\n                    <i aria-hidden=\"true\" data-kid=\"1-2-4-1-3-2\" data-lucide=\"arrow-up-right\" style=\"width:14px;height:14px\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"tn-footer\" data-kid=\"1-3\">\n        <div class=\"tn-shell tn-footer-inner\" data-kid=\"1-3-1\">\n            <span data-kid=\"1-3-1-1\">\n                DuecIt — real-time coding duels // every match is a lesson\n            </span>\n            <div class=\"tn-footer-links\" data-kid=\"1-3-1-2\">\n                <a data-kid=\"1-3-1-2-1\" href=\"#arena\">\n                    /arena\n                </a>\n                <a data-kid=\"1-3-1-2-2\" href=\"#leaderboard\">\n                    /leaderboard\n                </a>\n                <a data-kid=\"1-3-1-2-3\" href=\"#protocol\">\n                    /docs\n                </a>\n                <span data-dynamic=\"true\" data-kid=\"1-3-1-2-4\" data-name=\"system status indicator text\" data-reason=\"system status text updated based on server health\" style=\"color:var(--tn-green)\">\n                    status: operational\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons({ attrs: { 'stroke-width': 1.6 } });\n  const root = document.getElementById('duecit-terminal-noir');\n  const toggle = root.querySelector('[data-theme-toggle]');\n  toggle.addEventListener('click', () => {\n    root.classList.toggle('light');\n    root.animate([{ opacity: .76 }, { opacity: 1 }], { duration: 260, easing: 'ease-out' });\n  });\n</script>\n",
