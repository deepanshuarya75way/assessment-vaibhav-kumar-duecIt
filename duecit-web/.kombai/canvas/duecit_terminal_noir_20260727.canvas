      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  :root {\n    --ink: #010b13;\n    --carbon: #1b1b1b;\n    --carbon-2: #151515;\n    --line: #333333;\n    --line-soft: #242424;\n    --text: #e8eee9;\n    --muted: #84908a;\n    --faint: #4e5954;\n    --green: #00ff40;\n    --green-soft: rgba(0,255,64,.1);\n    --amber: #f0b85a;\n    --red: #ff6b6b;\n  }\n  [data-theme='light'] {\n    --ink: #eef2ee;\n    --carbon: #f8faf8;\n    --carbon-2: #e9eeea;\n    --line: #c7d0c9;\n    --line-soft: #dbe3dc;\n    --text: #101713;\n    --muted: #607069;\n    --faint: #9ba89f;\n    --green: #0b9a35;\n    --green-soft: rgba(11,154,53,.09);\n    --amber: #a0691d;\n    --red: #b03434;\n  }\n  .tn-shell * { box-sizing: border-box; }\n  .tn-shell { font-family: 'JetBrains Mono', monospace; background: var(--ink); color: var(--text); min-height: 100vh; animation: pageReveal .5s cubic-bezier(.22,1,.36,1) both; }\n  .tn-heading { font-family: 'Space Grotesk', sans-serif; }\n  .tn-grid { display: none; }\n  .tn-rule { border-color: var(--line); }\n  .tn-button { border: 1px solid var(--green); color: var(--ink); background: var(--green); transition: background .18s ease, color .18s ease, transform .18s ease; }\n  .tn-button:hover { background: transparent; color: var(--green); transform: translateY(-1px); }\n  .tn-ghost { border: 1px solid var(--line); color: var(--muted); background: transparent; transition: border-color .18s ease, color .18s ease, background .18s ease; }\n  .tn-ghost:hover { border-color: var(--green); color: var(--green); background: var(--green-soft); }\n  .tn-field { border-bottom: 1px solid var(--line); transition: border-color .18s ease, box-shadow .18s ease; }\n  .tn-field:focus-within { border-color: var(--green); box-shadow: 0 6px 0 -5px var(--green); animation: focusPulse 1.6s ease-in-out infinite; }\n  .tn-field input { color: var(--text); caret-color: var(--green); }\n  .tn-field input::placeholder { color: var(--faint); }\n  .tn-segment { height: 4px; background: var(--line); transition: background .2s ease, transform .2s ease; }\n  .tn-segment.on { background: var(--green); }\n  .tn-code-line { overflow: hidden; white-space: nowrap; max-width: 0; animation: typeLine 1.2s steps(42,end) forwards; }\n  .tn-code-line:nth-child(1) { animation-delay: .28s; }\n  .tn-code-line:nth-child(2) { animation-delay: .58s; }\n  .tn-code-line:nth-child(3) { animation-delay: .88s; }\n  .tn-code-line:nth-child(4) { animation-delay: 1.18s; }\n  .tn-code-line:nth-child(5) { animation-delay: 1.48s; }\n  .tn-code-line:nth-child(6) { animation-delay: 1.78s; }\n  .tn-cursor { animation: blink 1s step-end infinite; }\n  .tn-pulse { animation: livePulse 1.8s ease-in-out infinite; }\n  .tn-spinner { width: 13px; height: 13px; border: 1px solid var(--line); border-top-color: var(--green); border-radius: 50%; animation: spin .75s linear infinite; }\n  .tn-skeleton { height: 8px; background: linear-gradient(90deg, var(--line-soft), var(--line), var(--line-soft)); background-size: 220% 100%; animation: shimmer 1.5s linear infinite; }\n  .tn-toggle-knob { transition: transform .25s cubic-bezier(.22,1,.36,1); }\n  [data-theme='light'] .tn-toggle-knob { transform: translateX(18px); }\n  @keyframes pageReveal { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n  @keyframes focusPulse { 0%,100% { box-shadow: 0 6px 0 -5px var(--green); } 50% { box-shadow: 0 8px 0 -5px var(--green); } }\n  @keyframes typeLine { from { max-width: 0; } to { max-width: 100%; } }\n  @keyframes blink { 0%,49% { opacity: 1; } 50%,100% { opacity: 0; } }\n  @keyframes livePulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .42; transform: scale(.78); } }\n  @keyframes spin { to { transform: rotate(360deg); } }\n  @keyframes shimmer { from { background-position: 200% 0; } to { background-position: -20% 0; } }\n  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; } }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"tn-shell relative flex min-h-screen overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\" data-theme=\"dark\">\n    <div aria-hidden=\"true\" class=\"tn-grid pointer-events-none absolute inset-0\" data-kid=\"1-1\" data-name=\"grid background decorative layer\">\n    </div>\n    <aside class=\"relative z-10 flex w-[15%] min-w-[190px] flex-col justify-between border-r tn-rule bg-[var(--ink)] px-7 py-8\" data-kid=\"1-2\" data-name=\"sidebar navigation container\">\n        <div data-kid=\"1-2-1\" data-name=\"brand logo and protocol info wrapper\">\n            <a aria-label=\"DuecIt home\" class=\"group flex items-center gap-3 no-underline\" data-kid=\"1-2-1-1\" data-name=\"home link\" href=\"#\">\n                <span class=\"flex h-9 w-9 items-center justify-center border border-[var(--green)] text-[var(--green)] transition-transform duration-200 group-hover:rotate-90\" data-kid=\"1-2-1-1-1\" data-name=\"swords icon container\">\n                    <i data-kid=\"1-2-1-1-1-1\" data-lucide=\"swords\" data-name=\"swords icon\" style=\"width:18px;height:18px;color:var(--green)\">\n                    </i>\n                </span>\n                <span class=\"tn-heading text-[18px] font-bold tracking-[-.04em] text-[var(--text)]\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    DuecIt\n                    <span class=\"text-[var(--green)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"brand name period\">\n                        .\n                    </span>\n                </span>\n            </a>\n            <div class=\"mt-20 border-l border-[var(--green)] pl-4\" data-kid=\"1-2-1-2\" data-name=\"protocol details wrapper\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[.24em] text-[var(--green)]\" data-kid=\"1-2-1-2-1\" data-name=\"protocol title\">\n                    Protocol 01\n                </p>\n                <p class=\"mt-3 max-w-[145px] text-[11px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-1-2-2\" data-name=\"protocol description\">\n                    Real opponents.\n                    <br data-kid=\"1-2-1-2-2-1\" data-name=\"line break\"/>\n                    Real code.\n                    <br data-kid=\"1-2-1-2-2-2\" data-name=\"line break\"/>\n                    No spectators.\n                </p>\n            </div>\n        </div>\n        <div class=\"space-y-5 text-[10px] uppercase tracking-[.18em] text-[var(--faint)]\" data-kid=\"1-2-2\" data-name=\"system status container\">\n            <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1\" data-name=\"systems nominal status indicator\">\n                <span class=\"tn-pulse h-1.5 w-1.5 bg-[var(--green)]\" data-kid=\"1-2-2-1-1\" data-name=\"status pulse indicator\">\n                </span>\n                <span data-kid=\"1-2-2-1-2\" data-name=\"status label\">\n                    systems nominal\n                </span>\n            </div>\n            <div class=\"border-t tn-rule pt-4 leading-5\" data-kid=\"1-2-2-2\" data-name=\"version and gateway info\">\n                v0.8.4\n                <br data-kid=\"1-2-2-2-1\" data-name=\"line break\"/>\n                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-2-2-2\" data-name=\"gateway name text\">\n                    auth gateway / east-1\n                </span>\n            </div>\n        </div>\n    </aside>\n    <main class=\"relative z-10 flex min-w-0 flex-1 flex-col border-r tn-rule bg-[var(--carbon)]\" data-kid=\"1-3\" data-name=\"main content section\">\n        <header class=\"flex items-center justify-between border-b tn-rule px-10 py-6\" data-kid=\"1-3-1\" data-name=\"header bar\">\n            <div class=\"flex items-center gap-3 text-[10px] uppercase tracking-[.22em] text-[var(--muted)]\" data-kid=\"1-3-1-1\" data-name=\"breadcrumb path text\">\n                <span class=\"text-[var(--green)]\" data-kid=\"1-3-1-1-1\" data-name=\"breadcrumb slash separator\">\n                    /\n                </span>\n                identity checkpoint\n            </div>\n            <button aria-label=\"Switch theme\" class=\"group relative h-6 w-11 border tn-rule bg-[var(--carbon-2)] p-0.5\" data-kid=\"1-3-1-2\" data-name=\"theme toggle button\" id=\"theme-toggle\" type=\"button\">\n                <span class=\"tn-toggle-knob block h-[18px] w-[18px] bg-[var(--green)]\" data-kid=\"1-3-1-2-1\" data-name=\"theme toggle knob\">\n                </span>\n                <span class=\"pointer-events-none absolute -right-7 top-1/2 -translate-y-1/2 text-[var(--faint)]\" data-kid=\"1-3-1-2-2\" data-name=\"sun moon icon container\">\n                    <i data-kid=\"1-3-1-2-2-1\" data-lucide=\"sun-moon\" data-name=\"sun moon icon\" style=\"width:14px;height:14px;color:var(--muted)\">\n                    </i>\n                </span>\n            </button>\n        </header>\n        <section class=\"mx-auto flex w-full max-w-[510px] flex-1 flex-col justify-center px-10 py-12\" data-kid=\"1-3-2\" data-name=\"authentication card area\">\n            <div class=\"mb-9 flex items-end justify-between border-b tn-rule pb-5\" data-kid=\"1-3-2-1\" data-name=\"authentication header wrapper\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"authentication title and subtitle wrapper\">\n                    <p class=\"text-[10px] uppercase tracking-[.22em] text-[var(--green)]\" data-kid=\"1-3-2-1-1-1\" data-name=\"secure sign-in label\">\n                        secure sign-in\n                    </p>\n                    <h1 class=\"tn-heading mt-3 text-[38px] font-bold leading-none tracking-[-.055em] text-[var(--text)]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-2\" data-name=\"authentication heading text\" data-reason=\"text updated when switching between login/register modes\" id=\"form-title\">\n                        Enter the arena\n                        <span class=\"text-[var(--green)]\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"authentication heading period\">\n                            .\n                        </span>\n                    </h1>\n                    <p class=\"mt-3 text-[12px] leading-5 text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-3\" data-name=\"authentication subtitle text\" data-reason=\"text updated when switching between login/register modes\" id=\"form-subtitle\">\n                        Sign in to continue your duels.\n                    </p>\n                </div>\n                <div class=\"mb-1 flex items-center gap-2 text-[10px] text-[var(--faint)]\" data-kid=\"1-3-2-1-2\" data-name=\"live status indicator\">\n                    <span class=\"tn-pulse h-1.5 w-1.5 bg-[var(--green)]\" data-kid=\"1-3-2-1-2-1\" data-name=\"status pulse dot\">\n                    </span>\n                    live\n                </div>\n            </div>\n            <div aria-label=\"Authentication mode\" class=\"mb-8 flex border-b tn-rule\" data-kid=\"1-3-2-2\" data-name=\"authentication mode tablist\" role=\"tablist\">\n                <button aria-selected=\"true\" class=\"mode-tab flex-1 border-b-2 border-[var(--green)] pb-3 text-left text-[11px] font-bold uppercase tracking-[.16em] text-[var(--green)]\" data-kid=\"1-3-2-2-1\" data-mode=\"login\" data-name=\"login tab button\" role=\"tab\">\n                    01 / login\n                </button>\n                <button aria-selected=\"false\" class=\"mode-tab flex-1 border-b-2 border-transparent pb-3 text-left text-[11px] font-bold uppercase tracking-[.16em] text-[var(--faint)]\" data-kid=\"1-3-2-2-2\" data-mode=\"register\" data-name=\"register tab button\" role=\"tab\">\n                    02 / create account\n                </button>\n            </div>\n            <form class=\"space-y-7\" data-kid=\"1-3-2-3\" data-name=\"authentication form\" id=\"auth-form\" novalidate=\"\">\n                <div class=\"tn-field pb-3\" data-kid=\"1-3-2-3-1\" data-name=\"username input field container\" id=\"username-field\">\n                    <label class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[.2em] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-3-2-3-1-1\" data-name=\"username input label\" data-reason=\"label text updated when switching modes\" for=\"identity\">\n                        Username or email\n                    </label>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-3-1-2\" data-name=\"username input inner wrapper\">\n                        <span class=\"text-[var(--green)]\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"username currency prefix\">\n                            $\n                        </span>\n                        <input autocomplete=\"username\" class=\"min-w-0 flex-1 border-0 bg-transparent p-0 text-[14px] outline-none\" data-kid=\"1-3-2-3-1-2-2\" data-name=\"username input element\" id=\"identity\" placeholder=\"you@example.com\"/>\n                    </div>\n                </div>\n                <div class=\"tn-field hidden pb-3\" data-dynamic=\"true\" data-kid=\"1-3-2-3-2\" data-name=\"email input field container\" data-reason=\"container visibility toggled when switching modes\" id=\"register-email\">\n                    <label class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[.2em] text-[var(--muted)]\" data-kid=\"1-3-2-3-2-1\" data-name=\"email input label\" for=\"email\">\n                        Email\n                    </label>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-3-2-2\" data-name=\"email input inner wrapper\">\n                        <span class=\"text-[var(--green)]\" data-kid=\"1-3-2-3-2-2-1\" data-name=\"email currency prefix\">\n                            $\n                        </span>\n                        <input autocomplete=\"email\" class=\"min-w-0 flex-1 border-0 bg-transparent p-0 text-[14px] outline-none\" data-kid=\"1-3-2-3-2-2-2\" data-name=\"email input element\" id=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n                    </div>\n                </div>\n                <div class=\"tn-field pb-3\" data-kid=\"1-3-2-3-3\" data-name=\"password input field container\">\n                    <label class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[.2em] text-[var(--muted)]\" data-kid=\"1-3-2-3-3-1\" data-name=\"password input label\" for=\"password\">\n                        Password\n                    </label>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-3-3-2\" data-name=\"password input inner wrapper\">\n                        <span class=\"text-[var(--green)]\" data-kid=\"1-3-2-3-3-2-1\" data-name=\"password currency prefix\">\n                            $\n                        </span>\n                        <input autocomplete=\"current-password\" class=\"min-w-0 flex-1 border-0 bg-transparent p-0 text-[14px] outline-none\" data-kid=\"1-3-2-3-3-2-2\" data-name=\"password input element\" id=\"password\" placeholder=\"enter secure key\" type=\"password\"/>\n                        <button aria-label=\"Show password\" class=\"text-[var(--faint)] hover:text-[var(--green)]\" data-kid=\"1-3-2-3-3-2-3\" data-name=\"show password toggle button\" id=\"show-password\" type=\"button\">\n                            <i data-dynamic=\"true\" data-kid=\"1-3-2-3-3-2-3-1\" data-lucide=\"eye\" data-name=\"eye icon\" data-reason=\"icon replaced when toggling password visibility\" style=\"width:16px;height:16px;color:currentColor\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"hidden border-l border-[var(--green)] pl-4\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4\" data-name=\"password strength meter container\" data-reason=\"container visibility toggled based on mode and input\" id=\"password-meter\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-3-2-3-4-1\" data-name=\"password integrity header\">\n                        <span class=\"text-[10px] uppercase tracking-[.18em] text-[var(--muted)]\" data-kid=\"1-3-2-3-4-1-1\" data-name=\"integrity label\">\n                            key integrity\n                        </span>\n                        <span class=\"text-[10px] uppercase tracking-[.18em] text-[var(--green)]\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-1-2\" data-name=\"strength description text\" data-reason=\"text updated based on password strength\" id=\"strength-label\">\n                            awaiting input\n                        </span>\n                    </div>\n                    <div class=\"mb-3 grid grid-cols-5 gap-1\" data-kid=\"1-3-2-3-4-2\" data-name=\"password segment grid\">\n                        <span class=\"tn-segment\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-2-1\" data-name=\"password segment 1\" data-reason=\"color updated based on password strength\">\n                        </span>\n                        <span class=\"tn-segment\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-2-2\" data-name=\"password segment 2\" data-reason=\"color updated based on password strength\">\n                        </span>\n                        <span class=\"tn-segment\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-2-3\" data-name=\"password segment 3\" data-reason=\"color updated based on password strength\">\n                        </span>\n                        <span class=\"tn-segment\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-2-4\" data-name=\"password segment 4\" data-reason=\"color updated based on password strength\">\n                        </span>\n                        <span class=\"tn-segment\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-2-5\" data-name=\"password segment 5\" data-reason=\"color updated based on password strength\">\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-x-5 gap-y-2 text-[10px] text-[var(--muted)]\" data-kid=\"1-3-2-3-4-3\" data-name=\"password criteria list\">\n                        <span class=\"rule flex items-center gap-2\" data-kid=\"1-3-2-3-4-3-1\" data-name=\"password length rule\" data-rule=\"length\">\n                            <span class=\"rule-icon text-[var(--faint)]\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-3-1-1\" data-name=\"length rule indicator\" data-reason=\"icon and color updated on validation\">\n                                ·\n                            </span>\n                            8+ chars\n                        </span>\n                        <span class=\"rule flex items-center gap-2\" data-kid=\"1-3-2-3-4-3-2\" data-name=\"password uppercase rule\" data-rule=\"upper\">\n                            <span class=\"rule-icon text-[var(--faint)]\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-3-2-1\" data-name=\"uppercase rule indicator\" data-reason=\"icon and color updated on validation\">\n                                ·\n                            </span>\n                            uppercase\n                        </span>\n                        <span class=\"rule flex items-center gap-2\" data-kid=\"1-3-2-3-4-3-3\" data-name=\"password number rule\" data-rule=\"number\">\n                            <span class=\"rule-icon text-[var(--faint)]\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-3-3-1\" data-name=\"number rule indicator\" data-reason=\"icon and color updated on validation\">\n                                ·\n                            </span>\n                            one number\n                        </span>\n                        <span class=\"rule flex items-center gap-2\" data-kid=\"1-3-2-3-4-3-4\" data-name=\"password symbol rule\" data-rule=\"symbol\">\n                            <span class=\"rule-icon text-[var(--faint)]\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-3-4-1\" data-name=\"symbol rule indicator\" data-reason=\"icon and color updated on validation\">\n                                ·\n                            </span>\n                            one symbol\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center justify-between pt-1\" data-kid=\"1-3-2-3-5\" data-name=\"form footer navigation\">\n                    <a class=\"text-[11px] text-[var(--muted)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--green)]\" data-kid=\"1-3-2-3-5-1\" data-name=\"forgot password link\" href=\"#forgot\">\n                        forgot password?\n                    </a>\n                    <span class=\"text-[10px] text-[var(--faint)]\" data-kid=\"1-3-2-3-5-2\" data-name=\"cancel key reminder\">\n                        esc to cancel\n                    </span>\n                </div>\n                <button class=\"tn-button flex w-full items-center justify-between px-4 py-3 text-left text-[12px] font-bold uppercase tracking-[.15em]\" data-dynamic=\"true\" data-kid=\"1-3-2-3-6\" data-name=\"submit button\" data-reason=\"button text/content replaced by authentication state\" type=\"submit\">\n                    <span data-dynamic=\"true\" data-kid=\"1-3-2-3-6-1\" data-name=\"submit button label\" data-reason=\"text updated based on mode\" id=\"submit-label\">\n                        >_ continue\n                    </span>\n                    <i data-kid=\"1-3-2-3-6-2\" data-lucide=\"arrow-up-right\" data-name=\"submit arrow icon\" style=\"width:16px;height:16px;color:currentColor\">\n                    </i>\n                </button>\n            </form>\n            <div class=\"mt-8 grid grid-cols-3 divide-x tn-rule border-y tn-rule py-3 text-[9px] uppercase tracking-[.13em]\" data-kid=\"1-3-2-4\" data-name=\"status info grid\">\n                <div class=\"pr-3\" data-kid=\"1-3-2-4-1\" data-name=\"idle status column\">\n                    <span class=\"block text-[var(--faint)]\" data-kid=\"1-3-2-4-1-1\" data-name=\"idle label\">\n                        idle\n                    </span>\n                    <span class=\"mt-1 block text-[var(--muted)]\" data-kid=\"1-3-2-4-1-2\" data-name=\"idle text\">\n                        ready\n                    </span>\n                </div>\n                <div class=\"px-3\" data-kid=\"1-3-2-4-2\" data-name=\"loading status column\">\n                    <span class=\"flex items-center gap-2 text-[var(--faint)]\" data-kid=\"1-3-2-4-2-1\" data-name=\"loading label\">\n                        loading\n                        <span class=\"tn-spinner\" data-kid=\"1-3-2-4-2-1-1\" data-name=\"spinner\">\n                        </span>\n                    </span>\n                    <span class=\"mt-1 block text-[var(--muted)]\" data-kid=\"1-3-2-4-2-2\" data-name=\"loading subtext\">\n                        auth queue\n                    </span>\n                </div>\n                <div class=\"pl-3\" data-kid=\"1-3-2-4-3\" data-name=\"error status column\">\n                    <span class=\"block text-[var(--faint)]\" data-kid=\"1-3-2-4-3-1\" data-name=\"error label\">\n                        error\n                    </span>\n                    <span class=\"mt-1 block text-[var(--red)]\" data-kid=\"1-3-2-4-3-2\" data-name=\"error text\">\n                        invalid key\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-5 flex items-center gap-3\" data-kid=\"1-3-2-5\" data-name=\"session loading skeleton\">\n                <div class=\"tn-skeleton w-20\" data-kid=\"1-3-2-5-1\" data-name=\"skeleton bar 1\">\n                </div>\n                <div class=\"tn-skeleton w-32\" data-kid=\"1-3-2-5-2\" data-name=\"skeleton bar 2\">\n                </div>\n                <span class=\"text-[9px] uppercase tracking-[.12em] text-[var(--faint)]\" data-kid=\"1-3-2-5-3\" data-name=\"session hint text\">\n                    session hint\n                </span>\n            </div>\n        </section>\n    </main>\n    <aside class=\"relative z-10 flex w-[39%] min-w-[430px] flex-col bg-[var(--ink)] px-10 py-8\" data-kid=\"1-4\" data-name=\"live replay sidebar\">\n        <div class=\"flex items-center justify-between border-b tn-rule pb-5 text-[10px] uppercase tracking-[.2em] text-[var(--muted)]\" data-kid=\"1-4-1\" data-name=\"replay header\">\n            <span data-kid=\"1-4-1-1\" data-name=\"replay title\">\n                live duel / replay\n            </span>\n            <span class=\"flex items-center gap-2 text-[var(--green)]\" data-kid=\"1-4-1-2\" data-name=\"opponent status\">\n                <span class=\"tn-pulse h-1.5 w-1.5 bg-[var(--green)]\" data-kid=\"1-4-1-2-1\" data-name=\"opponent status pulse\">\n                </span>\n                opponent is coding\n            </span>\n        </div>\n        <div class=\"my-auto border tn-rule bg-[var(--carbon)]\" data-kid=\"1-4-2\" data-name=\"code editor display window\">\n            <div class=\"flex items-center justify-between border-b tn-rule px-5 py-3 text-[10px] text-[var(--muted)]\" data-kid=\"1-4-2-1\" data-name=\"editor tabs\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-4-2-1-1\" data-name=\"window control icons\">\n                    <span class=\"h-2 w-2 bg-[#ff5f57]\" data-kid=\"1-4-2-1-1-1\" data-name=\"red button\">\n                    </span>\n                    <span class=\"h-2 w-2 bg-[#febc2e]\" data-kid=\"1-4-2-1-1-2\" data-name=\"yellow button\">\n                    </span>\n                    <span class=\"h-2 w-2 bg-[var(--green)]\" data-kid=\"1-4-2-1-1-3\" data-name=\"green button\">\n                    </span>\n                    <span class=\"ml-2\" data-kid=\"1-4-2-1-1-4\" data-name=\"filename text\">\n                        solution.py\n                    </span>\n                </span>\n                <span class=\"text-[var(--green)]\" data-kid=\"1-4-2-1-2\" data-name=\"mode text\">\n                    READ / WRITE\n                </span>\n            </div>\n            <div class=\"p-6 text-[13px] leading-7 text-[var(--text)]\" data-kid=\"1-4-2-2\" data-name=\"code content area\">\n                <div class=\"tn-code-line\" data-kid=\"1-4-2-2-1\" data-name=\"code line 1\">\n                    <span class=\"mr-5 inline-block w-5 text-right text-[var(--faint)]\" data-kid=\"1-4-2-2-1-1\" data-name=\"line number 1\">\n                        01\n                    </span>\n                    <span class=\"text-[#c792ea]\" data-kid=\"1-4-2-2-1-2\" data-name=\"code keyword\">\n                        def\n                    </span>\n                    <span class=\"text-[#82aaff]\" data-kid=\"1-4-2-2-1-3\" data-name=\"code identifier\">\n                        two_sum\n                    </span>\n                    (nums, target):\n                </div>\n                <div class=\"tn-code-line\" data-kid=\"1-4-2-2-2\" data-name=\"code line 2\">\n                    <span class=\"mr-5 inline-block w-5 text-right text-[var(--faint)]\" data-kid=\"1-4-2-2-2-1\" data-name=\"line number 2\">\n                        02\n                    </span>\n                    seen = {}\n                </div>\n                <div class=\"tn-code-line\" data-kid=\"1-4-2-2-3\" data-name=\"code line 3\">\n                    <span class=\"mr-5 inline-block w-5 text-right text-[var(--faint)]\" data-kid=\"1-4-2-2-3-1\" data-name=\"line number 3\">\n                        03\n                    </span>\n                    <span class=\"text-[#c792ea]\" data-kid=\"1-4-2-2-3-2\" data-name=\"code keyword 1\">\n                        for\n                    </span>\n                    i, n\n                    <span class=\"text-[#c792ea]\" data-kid=\"1-4-2-2-3-3\" data-name=\"code keyword 2\">\n                        in\n                    </span>\n                    enumerate(nums):\n                </div>\n                <div class=\"tn-code-line\" data-kid=\"1-4-2-2-4\" data-name=\"code line 4\">\n                    <span class=\"mr-5 inline-block w-5 text-right text-[var(--faint)]\" data-kid=\"1-4-2-2-4-1\" data-name=\"line number 4\">\n                        04\n                    </span>\n                    diff = target - n\n                </div>\n                <div class=\"tn-code-line\" data-kid=\"1-4-2-2-5\" data-name=\"code line 5\">\n                    <span class=\"mr-5 inline-block w-5 text-right text-[var(--faint)]\" data-kid=\"1-4-2-2-5-1\" data-name=\"line number 5\">\n                        05\n                    </span>\n                    <span class=\"text-[#c792ea]\" data-kid=\"1-4-2-2-5-2\" data-name=\"code keyword\">\n                        if\n                    </span>\n                    diff\n                    <span class=\"text-[#c792ea]\" data-kid=\"1-4-2-2-5-3\" data-name=\"code keyword 2\">\n                        in\n                    </span>\n                    seen:\n                </div>\n                <div class=\"tn-code-line\" data-kid=\"1-4-2-2-6\" data-name=\"code line 6\">\n                    <span class=\"mr-5 inline-block w-5 text-right text-[var(--faint)]\" data-kid=\"1-4-2-2-6-1\" data-name=\"line number 6\">\n                        06\n                    </span>\n                    <span class=\"text-[#00ff40]\" data-kid=\"1-4-2-2-6-2\" data-name=\"code return keyword\">\n                        return\n                    </span>\n                    [seen[diff], i]\n                    <span class=\"tn-cursor ml-1 text-[var(--green)]\" data-kid=\"1-4-2-2-6-3\" data-name=\"animated text cursor\">\n                        ▌\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center justify-between border-t tn-rule px-5 py-3 text-[10px] uppercase tracking-[.16em]\" data-kid=\"1-4-2-3\" data-name=\"editor footer\">\n                <span class=\"flex items-center gap-2 text-[var(--green)]\" data-kid=\"1-4-2-3-1\" data-name=\"typing signal\">\n                    <span class=\"tn-pulse h-1.5 w-1.5 bg-[var(--green)]\" data-kid=\"1-4-2-3-1-1\" data-name=\"typing pulse\">\n                    </span>\n                    typing signal\n                </span>\n                <span class=\"text-[var(--muted)]\" data-kid=\"1-4-2-3-2\" data-name=\"remaining time\">\n                    08:32 remaining\n                </span>\n            </div>\n        </div>\n        <div class=\"border-t tn-rule pt-5 text-[10px] uppercase tracking-[.16em] text-[var(--faint)]\" data-kid=\"1-4-3\" data-name=\"match metadata footer\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-4-3-1\" data-name=\"match info\">\n                <span data-kid=\"1-4-3-1-1\" data-name=\"match id\">\n                    match / 7f4c2a\n                </span>\n                <span data-kid=\"1-4-3-1-2\" data-name=\"language info\">\n                    python 3\n                </span>\n            </div>\n            <div class=\"mt-3 flex items-center gap-2 text-[var(--muted)]\" data-kid=\"1-4-3-2\" data-name=\"security status\">\n                <i data-kid=\"1-4-3-2-1\" data-lucide=\"shield-check\" data-name=\"shield icon\" style=\"width:14px;height:14px;color:var(--green)\">\n                </i>\n                <span data-kid=\"1-4-3-2-2\" data-name=\"security message\">\n                    anti-capture active · hidden tests armed\n                </span>\n            </div>\n        </div>\n    </aside>\n</div>\n<script>\n    lucide.createIcons();\n  const root = document.querySelector('.tn-shell');\n  const toggle = document.querySelector('#theme-toggle');\n  toggle.addEventListener('click', () => root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark');\n  const tabs = document.querySelectorAll('.mode-tab');\n  const registerEmail = document.querySelector('#register-email');\n  const passwordMeter = document.querySelector('#password-meter');\n  const title = document.querySelector('#form-title');\n  const subtitle = document.querySelector('#form-subtitle');\n  const identityLabel = document.querySelector('#username-field label');\n  const submitLabel = document.querySelector('#submit-label');\n  tabs.forEach((tab) => tab.addEventListener('click', () => {\n    const register = tab.dataset.mode === 'register';\n    tabs.forEach((item) => { const active = item === tab; item.classList.toggle('border-[var(--green)]', active); item.classList.toggle('text-[var(--green)]', active); item.classList.toggle('border-transparent', !active); item.classList.toggle('text-[var(--faint)]', !active); item.setAttribute('aria-selected', String(active)); });\n    registerEmail.classList.toggle('hidden', !register);\n    passwordMeter.classList.toggle('hidden', !register);\n    title.innerHTML = register ? 'Join the arena<span class=\"text-[var(--green)]\">.</span>' : 'Enter the arena<span class=\"text-[var(--green)]\">.</span>';\n    subtitle.textContent = register ? 'Create your identity and find your first opponent.' : 'Sign in to continue your duels.';\n    identityLabel.textContent = register ? 'Username' : 'Username or email';\n    submitLabel.textContent = register ? '>_ create account' : '>_ continue';\n    document.querySelector('#password').setAttribute('autocomplete', register ? 'new-password' : 'current-password');\n  }));\n  const password = document.querySelector('#password');\n  const meter = document.querySelectorAll('.tn-segment');\n  const strengthLabel = document.querySelector('#strength-label');\n  const check = (key, ok) => { const rule = document.querySelector('[data-rule=\"'+key+'\"]'); if (!rule) return; const icon = rule.querySelector('.rule-icon'); icon.textContent = ok ? '✓' : '·'; icon.style.color = ok ? 'var(--green)' : 'var(--faint)'; rule.style.color = ok ? 'var(--green)' : 'var(--muted)'; };\n  password.addEventListener('input', () => { const value = password.value; const score = [value.length >= 8, /[A-Z]/.test(value), /[0-9]/.test(value), /[^A-Za-z0-9]/.test(value)].filter(Boolean).length; meter.forEach((segment, i) => segment.classList.toggle('on', i < Math.min(5, score + (value.length > 12 ? 1 : 0)))); strengthLabel.textContent = value ? (score < 2 ? 'weak' : score < 4 ? 'good' : 'very strong') : 'awaiting input'; check('length', value.length >= 8); check('upper', /[A-Z]/.test(value)); check('number', /[0-9]/.test(value)); check('symbol', /[^A-Za-z0-9]/.test(value)); });\n  document.querySelector('#show-password').addEventListener('click', (event) => { password.type = password.type === 'password' ? 'text' : 'password'; event.currentTarget.innerHTML = password.type === 'password' ? '<i data-lucide=\"eye\" style=\"width:16px;height:16px;color:currentColor\"></i>' : '<i data-lucide=\"eye-off\" style=\"width:16px;height:16px;color:currentColor\"></i>'; lucide.createIcons(); });\n  document.querySelector('#auth-form').addEventListener('submit', (event) => { event.preventDefault(); const button = event.currentTarget.querySelector('button[type=\"submit\"]'); button.disabled = true; button.innerHTML = '<span class=\"flex items-center gap-3\"><span class=\"tn-spinner\" style=\"border-color:var(--ink);border-top-color:transparent\"></span> authenticating</span><i data-lucide=\"loader-circle\" style=\"width:16px;height:16px;color:currentColor\"></i>'; lucide.createIcons(); setTimeout(() => { button.disabled = false; button.innerHTML = '<span class=\"text-[var(--red)]\">error: invalid key</span><span class=\"text-[var(--red)]\">retry</span>'; }, 1200); });\n</script>\n",
      "comments": [],
      "created": "2026-07-27T20:27:24.237512+00:00",
      "modified": "2026-07-27T20:36:36.156993+00:00",
      "id": "var_a409f245ebdd"
    },
    "var_43018d1f6243": {
      "type": "variant",
      "label": "DuecIt — Terminal Noir Admin",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8600,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://unpkg.com/lucide@latest/dist/umd/lucide.min.js');\n\n  :root {\n    --ink: #010b13;\n    --carbon: #101820;\n    --carbon-2: #151f27;\n    --carbon-3: #1c2931;\n    --line: #2b3941;\n    --line-soft: #1d2a31;\n    --text: #e6f0ec;\n    --muted: #83929a;\n    --faint: #53636b;\n    --green: #00ff40;\n    --green-dim: rgba(0,255,64,.12);\n    --amber: #f4b942;\n    --amber-dim: rgba(244,185,66,.13);\n    --red: #ff6572;\n    --red-dim: rgba(255,101,114,.12);\n    --cyan: #62d9ff;\n    --shadow: 0 18px 48px rgba(0,0,0,.22);\n  }\n  body.light {\n    --ink: #edf2ee;\n    --carbon: #f8faf8;\n    --carbon-2: #ffffff;\n    --carbon-3: #e9efeb;\n    --line: #cbd7d0;\n    --line-soft: #dde7e1;\n    --text: #132119;\n    --muted: #63756b;\n    --faint: #92a198;\n    --green: #008f2a;\n    --green-dim: rgba(0,143,42,.1);\n    --amber: #9a6500;\n    --amber-dim: rgba(154,101,0,.11);\n    --red: #c52d3b;\n    --red-dim: rgba(197,45,59,.1);\n    --cyan: #087a9f;\n    --shadow: 0 16px 40px rgba(18,44,27,.08);\n  }\n  .admin-shell { font-family: 'Space Grotesk', ui-sans-serif, sans-serif; background: var(--ink); color: var(--text); min-height: 100vh; }\n  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n  .scanlines { background-image: linear-gradient(to bottom, transparent 0, transparent 3px, rgba(255,255,255,.018) 4px); background-size: 100% 4px; }\n  .panel { background: var(--carbon); border: 1px solid var(--line); border-radius: 2px; animation: boot .35s ease both; }\n  .panel-flat { background: var(--carbon); border: 1px solid var(--line); border-radius: 2px; }\n  .hairline { border-color: var(--line); }\n  .green-text { color: var(--green); }\n  .muted { color: var(--muted); }\n  .faint { color: var(--faint); }\n  .status-dot { width: 7px; height: 7px; border-radius: 999px; display: inline-block; background: var(--green); animation: breathe 2.4s ease-in-out infinite; }\n  .status-dot.amber { background: var(--amber); }\n  .status-dot.red { background: var(--red); }\n  .sidebar-link { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 12px; color: var(--muted); border-left: 2px solid transparent; transition: color .18s ease, background .18s ease, border-color .18s ease; }\n  .sidebar-link:hover { color: var(--text); background: var(--carbon-2); }\n  .sidebar-link.active { color: var(--green); background: var(--green-dim); border-left-color: var(--green); }\n  .readout { padding: 0 24px; border-right: 1px solid var(--line); }\n  .readout:first-child { padding-left: 0; }\n  .readout:last-child { border-right: 0; }\n  .toolbar-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 32px; padding: 0 11px; border: 1px solid var(--line); border-radius: 2px; color: var(--muted); background: var(--carbon-2); transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease; }\n  .toolbar-btn:hover { color: var(--text); border-color: var(--green); background: var(--green-dim); transform: translateY(-1px); }\n  .toolbar-btn.primary { color: var(--ink); border-color: var(--green); background: var(--green); font-weight: 700; }\n  .toolbar-btn.primary:hover { background: var(--text); border-color: var(--text); }\n  .problem-row { display: block; width: 100%; padding: 12px 14px; border-left: 2px solid transparent; text-align: left; border-bottom: 1px solid var(--line-soft); transition: background .18s ease, border-color .18s ease; }\n  .problem-row:hover { background: var(--carbon-2); }\n  .problem-row.selected { background: var(--green-dim); border-left-color: var(--green); }\n  .status-cell { padding: 4px 7px; border: 1px solid var(--line); border-radius: 2px; font-size: 10px; font-weight: 700; letter-spacing: .08em; }\n  .status-cell.green { color: var(--green); border-color: color-mix(in srgb, var(--green) 42%, var(--line)); background: var(--green-dim); }\n  .status-cell.amber { color: var(--amber); border-color: color-mix(in srgb, var(--amber) 40%, var(--line)); background: var(--amber-dim); }\n  .status-cell.red { color: var(--red); border-color: color-mix(in srgb, var(--red) 40%, var(--line)); background: var(--red-dim); }\n  .code-block { color: #b9d4c2; background: #071118; border: 1px solid var(--line-soft); border-radius: 2px; }\n  body.light .code-block { color: #21432b; background: #eff6f1; }\n  .skeleton { background: linear-gradient(90deg, var(--carbon-2) 20%, var(--carbon-3) 38%, var(--carbon-2) 56%); background-size: 220% 100%; animation: shimmer 1.8s ease-in-out infinite; }\n  .modal-hint { border: 1px solid color-mix(in srgb, var(--green) 55%, var(--line)); }\n  .theme-toggle { position: relative; overflow: hidden; }\n  .theme-toggle::after { content: ''; position: absolute; inset: 0; background: var(--green); transform: translateY(100%); transition: transform .28s cubic-bezier(.22,1,.36,1); z-index: 0; }\n  .theme-toggle:hover::after { transform: translateY(0); }\n  .theme-toggle > * { position: relative; z-index: 1; }\n  @keyframes boot { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }\n  @keyframes breathe { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .55; transform: scale(.78); } }\n  @keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }\n  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; } }\n</style>\n<div class=\"admin-shell scanlines min-h-screen\" data-kid=\"1\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\">\n        <aside class=\"w-[236px] shrink-0 border-r hairline bg-[var(--carbon)] flex flex-col\" data-kid=\"1-1-1\">\n        