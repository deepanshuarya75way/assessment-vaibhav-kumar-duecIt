PORT=8080
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017
MONGO_DB=duel_db

REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3000

ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
REFRESH_TOKEN_EXPIRY=168h

# Local self-hosted Piston from docker-compose.yml. Production should point
# at your Caddy-protected VPS URL, e.g. https://piston.example.com/api/v2.
PISTON_URL=http://4.240.60.219:2000
PISTON_AUTH_USER=
PISTON_AUTH_PASS=

READ_PHASE_SECONDS=45
CODING_PHASE_SECONDS=600
ELO_RANGE=200
DISCONNECT_GRACE_SECONDS=60

FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# OAuth (optional — leave empty to disable)
