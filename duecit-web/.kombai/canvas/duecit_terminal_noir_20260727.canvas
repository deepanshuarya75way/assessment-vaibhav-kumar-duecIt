      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  :root { --ink:#010B13; --carbon:#1B1B1B; --carbon-2:#101820; --line:#2b3a40; --line-strong:#3d5158; --text:#d7ffe0; --muted:#7f9b8b; --faint:#4c6658; --green:#00FF40; --green-dim:rgba(0,255,64,.10); --amber:#f4b740; --amber-dim:rgba(244,183,64,.10); }\n  .terminal-shell * { box-sizing:border-box; }\n  body { margin:0; background:var(--ink); color:var(--text); font-family:'JetBrains Mono',ui-monospace,monospace; }\n  .terminal-shell { min-height:100vh; background:linear-gradient(180deg,#010B13 0%,#010B13 78%,#020f18 100%); position:relative; overflow:hidden; }\n  .terminal-shell:before { content:''; position:absolute; inset:0; pointer-events:none; opacity:.16; background:repeating-linear-gradient(180deg,rgba(0,255,64,.08) 0px,rgba(0,255,64,.08) 1px,transparent 1px,transparent 6px); mix-blend-mode:screen; }\n  .topbar { height:58px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; padding:0 30px; position:relative; z-index:2; background:rgba(1,11,19,.88); }\n  .brand { display:flex; align-items:center; gap:12px; color:var(--text); font-family:'Space Grotesk',sans-serif; font-weight:700; letter-spacing:.02em; }\n  .brand-mark { width:26px; height:26px; display:grid; place-items:center; border:1px solid var(--green); color:var(--green); font-size:13px; }\n  .route { color:var(--muted); font-size:11px; margin-left:20px; border-left:1px solid var(--line); padding-left:20px; }\n  .top-actions { display:flex; align-items:center; gap:18px; color:var(--muted); font-size:11px; }\n  .identity { color:var(--text); }\n  .identity b { color:var(--green); font-weight:600; }\n  .theme-button { width:30px; height:30px; border:1px solid var(--line-strong); background:transparent; color:var(--muted); display:grid; place-items:center; cursor:pointer; transition:color .18s ease,border-color .18s ease,background .18s ease; }\n  .theme-button:hover { color:var(--green); border-color:var(--green); background:var(--green-dim); }\n  .page { position:relative; z-index:1; max-width:1160px; margin:0 auto; padding:40px 34px 36px; }\n  .eyebrow-row { display:flex; align-items:center; justify-content:space-between; gap:20px; color:var(--muted); font-size:11px; letter-spacing:.13em; text-transform:uppercase; }\n  .eyebrow-row .live { color:var(--green); display:flex; align-items:center; gap:8px; }\n  .live-dot { width:6px; height:6px; background:var(--green); animation:pulse 2s ease-in-out infinite; }\n  .result-stage { display:grid; grid-template-columns:minmax(0,1fr) 292px; gap:34px; align-items:end; padding:36px 0 30px; border-bottom:1px solid var(--line); animation:resultReveal .7s cubic-bezier(.22,1,.36,1) both; }\n  .verdict-label { color:var(--green); font-size:12px; letter-spacing:.16em; text-transform:uppercase; margin-bottom:10px; }\n  .verdict { margin:0; color:var(--green); font-family:'Space Grotesk',sans-serif; font-size:clamp(88px,12vw,156px); line-height:.8; letter-spacing:-.085em; font-weight:700; }\n  .problem-line { margin-top:22px; display:flex; align-items:center; flex-wrap:wrap; gap:10px; font-size:13px; color:var(--muted); }\n  .problem-line strong { color:var(--text); font-family:'Space Grotesk',sans-serif; font-size:20px; letter-spacing:-.02em; }\n  .divider-dot { color:var(--faint); }\n  .status-note { border-left:2px solid var(--green); padding:12px 15px; background:var(--green-dim); color:var(--text); font-size:12px; line-height:1.65; }\n  .status-note strong { display:block; color:var(--green); font-size:11px; letter-spacing:.12em; text-transform:uppercase; margin-bottom:5px; }\n  .meta-grid { display:grid; grid-template-columns:repeat(3,1fr); border-bottom:1px solid var(--line); }\n  .meta-cell { padding:16px 18px 17px 0; border-right:1px solid var(--line); margin-right:18px; }\n  .meta-cell:last-child { border-right:0; margin-right:0; }\n  .meta-k { color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.12em; }\n  .meta-v { color:var(--text); font-size:15px; margin-top:7px; }\n  .meta-v.green { color:var(--green); }\n  .section { margin-top:30px; }\n  .section-heading { display:flex; align-items:baseline; justify-content:space-between; border-bottom:1px solid var(--line); padding-bottom:10px; margin-bottom:0; }\n  .section-heading h2 { margin:0; color:var(--text); font-family:'Space Grotesk',sans-serif; font-size:15px; letter-spacing:.02em; }\n  .section-heading span { color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.13em; }\n  .head-table { width:100%; border-collapse:collapse; font-size:12px; }\n  .head-table th { color:var(--muted); font-weight:500; text-transform:uppercase; letter-spacing:.1em; font-size:10px; text-align:left; padding:12px 12px 11px; border-bottom:1px solid var(--line); }\n  .head-table td { padding:17px 12px; border-bottom:1px solid var(--line); color:var(--text); }\n  .head-table th:first-child,.head-table td:first-child { padding-left:0; }\n  .head-table th:last-child,.head-table td:last-child { padding-right:0; }\n  .head-table tbody tr.winner { border-left:2px solid var(--green); background:linear-gradient(90deg,var(--green-dim),transparent 55%); }\n  .head-table tbody tr.loser { border-left:2px solid transparent; }\n  .player { display:flex; align-items:center; gap:10px; font-family:'Space Grotesk',sans-serif; font-size:15px; font-weight:600; }\n  .player-mark { width:24px; height:24px; display:grid; place-items:center; border:1px solid var(--line-strong); color:var(--muted); font-size:10px; }\n  .winner .player-mark { color:var(--green); border-color:var(--green); }\n  .winner .player-name { color:var(--green); }\n  .muted { color:var(--muted); }\n  .positive { color:var(--green); font-weight:600; }\n  .negative { color:#d89272; font-weight:600; }\n  .timeline { position:relative; display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:0; padding:24px 0 4px; }\n  .timeline:before { content:''; position:absolute; left:6px; right:6px; top:31px; height:1px; background:var(--line-strong); }\n  .event { position:relative; display:flex; flex-direction:column; gap:9px; }\n  .event:not(:first-child) { align-items:center; }\n  .event:last-child { align-items:flex-end; }\n  .event-dot { width:12px; height:12px; background:var(--ink); border:1px solid var(--muted); position:relative; z-index:1; }\n  .event.done .event-dot { background:var(--green); border-color:var(--green); }\n  .event-name { color:var(--text); font-size:11px; text-transform:uppercase; letter-spacing:.1em; }\n  .event-time { color:var(--muted); font-size:11px; }\n  .solutions details { border-bottom:1px solid var(--line); }\n  .solutions summary { list-style:none; cursor:pointer; display:flex; align-items:center; justify-content:space-between; padding:14px 0; color:var(--text); font-size:12px; }\n  .solutions summary::-webkit-details-marker { display:none; }\n  .solution-title { display:flex; align-items:center; gap:12px; }\n  .solution-title .tag { color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.1em; }\n  .solution-title .accepted { color:var(--green); }\n  .chevron { color:var(--muted); font-size:12px; transition:transform .18s ease; }\n  details[open] .chevron { transform:rotate(180deg); color:var(--green); }\n  .code-wrap { margin:0 0 16px; background:var(--carbon); border:1px solid var(--line); padding:17px 18px; overflow:auto; }\n  pre { margin:0; color:#b7eac1; font-size:12px; line-height:1.75; }\n  .ln { color:var(--faint); display:inline-block; width:26px; user-select:none; }\n  .kw { color:#74c7ff; }.fn { color:var(--green); }.str { color:#d9c27b; }.cm { color:#60806b; }\n  .commands { display:flex; justify-content:space-between; align-items:center; gap:20px; padding-top:30px; color:var(--muted); font-size:12px; }\n  .commands a { color:var(--text); text-decoration:none; border-bottom:1px solid var(--line-strong); padding-bottom:4px; transition:color .18s ease,border-color .18s ease; }\n  .commands a:hover { color:var(--green); border-color:var(--green); }\n  .commands span { color:var(--faint); }\n  @keyframes resultReveal { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }\n  @keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:.42; } }\n  @media (max-width:800px) { .topbar{padding:0 18px}.route{display:none}.page{padding:28px 18px}.result-stage{grid-template-columns:1fr;gap:26px}.meta-grid{grid-template-columns:1fr 1fr}.meta-cell:nth-child(2){border-right:0}.meta-cell:nth-child(3){grid-column:1/-1;border-top:1px solid var(--line);padding-top:14px}.head-table{min-width:760px}.section{overflow-x:auto}.timeline{min-width:640px}.commands{align-items:flex-start;flex-direction:column} }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"terminal-shell\" data-kid=\"1\" data-name=\"terminal shell container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <div class=\"flex items-center gap-4\" data-kid=\"1-1-1\" data-name=\"brand and route container\">\n            <div class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand identity group\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i data-kid=\"1-1-1-1-1-1\" data-lucide=\"terminal\" data-name=\"terminal icon\" style=\"width:14px;height:14px;stroke-width:1.8\">\n                    </i>\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DuecIt\n                </span>\n            </div>\n            <span class=\"route\" data-dynamic=\"true\" data-kid=\"1-1-1-2\" data-name=\"current page route path\" data-reason=\"text content dynamically reflects current URL structure\">\n                /result/match_8F2A91\n            </span>\n        </div>\n        <div class=\"top-actions\" data-kid=\"1-1-2\" data-name=\"top actions group\">\n            <span class=\"identity\" data-kid=\"1-1-2-1\" data-name=\"user identity display\">\n                signed in as\n                <b data-dynamic=\"true\" data-kid=\"1-1-2-1-1\" data-name=\"current username\" data-reason=\"username fetched and injected by session script\">\n                    devkumar_19\n                </b>\n            </span>\n            <button aria-label=\"Switch theme\" class=\"theme-button\" data-kid=\"1-1-2-2\" data-name=\"theme toggle button\" title=\"Switch theme\">\n                <i data-kid=\"1-1-2-2-1\" data-lucide=\"sun-moon\" data-name=\"sun moon icon\" style=\"width:15px;height:15px;stroke-width:1.7\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"page\" data-kid=\"1-2\" data-name=\"main page content area\">\n        <div class=\"eyebrow-row\" data-kid=\"1-2-1\" data-name=\"eyebrow information row\">\n            <span class=\"live\" data-kid=\"1-2-1-1\" data-name=\"live status indicator\">\n                <span class=\"live-dot\" data-kid=\"1-2-1-1-1\" data-name=\"live status pulsing dot\">\n                </span>\n                match report / finalized\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"match timestamp\" data-reason=\"datetime rendered by server or local clock sync\">\n                2026.07.27 · 10:14:32 UTC\n            </span>\n        </div>\n        <section class=\"result-stage\" data-kid=\"1-2-2\" data-name=\"result stage section\">\n            <div data-kid=\"1-2-2-1\" data-name=\"verdict details column\">\n                <div class=\"verdict-label\" data-kid=\"1-2-2-1-1\" data-name=\"verdict label text\">\n                    accepted outcome // rated competitive\n                </div>\n                <h1 class=\"verdict\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"match outcome verdict\" data-reason=\"verdict string fetched based on match result\">\n                    WIN\n                </h1>\n                <div class=\"problem-line\" data-kid=\"1-2-2-1-3\" data-name=\"problem meta information line\">\n                    <strong data-dynamic=\"true\" data-kid=\"1-2-2-1-3-1\" data-name=\"problem name\" data-reason=\"problem title fetched dynamically\">\n                        LRU Cache\n                    </strong>\n                    <span class=\"divider-dot\" data-kid=\"1-2-2-1-3-2\" data-name=\"first separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-2-1-3-3\" data-name=\"problem category and difficulty text\">\n                        DSA / medium\n                    </span>\n                    <span class=\"divider-dot\" data-kid=\"1-2-2-1-3-4\" data-name=\"second separator dot\">\n                        ·\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-2-1-3-5\" data-name=\"hidden tests count\" data-reason=\"test count updated by judge system\">\n                        47 hidden tests\n                    </span>\n                </div>\n            </div>\n            <div class=\"status-note\" data-kid=\"1-2-2-2\" data-name=\"status note container\">\n                <strong data-kid=\"1-2-2-2-1\" data-name=\"final verdict heading\">\n                    final verdict\n                </strong>\n                <span data-kid=\"1-2-2-2-2\" data-name=\"status explanation text\">\n                    <span class=\"positive\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-1\" data-name=\"winner username\" data-reason=\"winner username injected based on match data\">\n                        sarah_codes\n                    </span>\n                    completed first with a full-accept submission. Rating update committed to both profiles.\n                </span>\n            </div>\n        </section>\n        <div class=\"meta-grid\" data-kid=\"1-2-3\" data-name=\"metadata grid\">\n            <div class=\"meta-cell\" data-kid=\"1-2-3-1\" data-name=\"match id column\">\n                <div class=\"meta-k\" data-kid=\"1-2-3-1-1\" data-name=\"match id label\">\n                    match id\n                </div>\n                <div class=\"meta-v\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2\" data-name=\"match id value\" data-reason=\"match ID injected by application state\">\n                    8F2A91C4\n                </div>\n            </div>\n            <div class=\"meta-cell\" data-kid=\"1-2-3-2\" data-name=\"mode column\">\n                <div class=\"meta-k\" data-kid=\"1-2-3-2-1\" data-name=\"mode label\">\n                    mode\n                </div>\n                <div class=\"meta-v\" data-dynamic=\"true\" data-kid=\"1-2-3-2-2\" data-name=\"match mode and type\" data-reason=\"mode information fetched dynamically\">\n                    competitive · DSA\n                </div>\n            </div>\n            <div class=\"meta-cell\" data-kid=\"1-2-3-3\" data-name=\"result states column\">\n                <div class=\"meta-k\" data-kid=\"1-2-3-3-1\" data-name=\"result states label\">\n                    result states\n                </div>\n                <div class=\"meta-v\" data-kid=\"1-2-3-3-2\" data-name=\"result states group\">\n                    <span class=\"green\" data-dynamic=\"true\" data-kid=\"1-2-3-3-2-1\" data-name=\"win status\" data-reason=\"win status style applied by result\">\n                        WIN\n                    </span>\n                    <span class=\"muted\" data-kid=\"1-2-3-3-2-2\" data-name=\"other status text\">\n                        / DRAW / LOSS\n                    </span>\n                </div>\n            </div>\n        </div>\n        <section class=\"section\" data-kid=\"1-2-4\" data-name=\"head to head section\">\n            <div class=\"section-heading\" data-kid=\"1-2-4-1\" data-name=\"section heading group\">\n                <h2 data-kid=\"1-2-4-1-1\" data-name=\"head to head title\">\n                    head_to_head\n                </h2>\n                <span data-kid=\"1-2-4-1-2\" data-name=\"execution summary label\">\n                    execution summary\n                </span>\n            </div>\n            <table class=\"head-table\" data-kid=\"1-2-4-2\" data-name=\"execution results table\">\n                <thead data-kid=\"1-2-4-2-1\" data-name=\"table head\">\n                    <tr data-kid=\"1-2-4-2-1-1\" data-name=\"table header row\">\n                        <th data-kid=\"1-2-4-2-1-1-1\" data-name=\"player column header\">\n                            player\n                        </th>\n                        <th data-kid=\"1-2-4-2-1-1-2\" data-name=\"score column header\">\n                            score\n                        </th>\n                        <th data-kid=\"1-2-4-2-1-1-3\" data-name=\"time column header\">\n                            solve time\n                        </th>\n                        <th data-kid=\"1-2-4-2-1-1-4\" data-name=\"tests column header\">\n                            tests\n                        </th>\n                        <th data-kid=\"1-2-4-2-1-1-5\" data-name=\"elo delta column header\">\n                            elo delta\n                        </th>\n                        <th data-kid=\"1-2-4-2-1-1-6\" data-name=\"rating column header\">\n                            final rating\n                        </th>\n                    </tr>\n                </thead>\n                <tbody data-kid=\"1-2-4-2-2\" data-name=\"table body\">\n                    <tr class=\"winner\" data-kid=\"1-2-4-2-2-1\" data-name=\"winner row\">\n                        <td data-kid=\"1-2-4-2-2-1-1\" data-name=\"winner cell\">\n                            <div class=\"player\" data-kid=\"1-2-4-2-2-1-1-1\" data-name=\"winner player identity\">\n                                <span class=\"player-mark\" data-kid=\"1-2-4-2-2-1-1-1-1\" data-name=\"trophy icon container\">\n                                    <i data-kid=\"1-2-4-2-2-1-1-1-1-1\" data-lucide=\"trophy\" data-name=\"trophy icon\" style=\"width:13px;height:13px;stroke-width:1.7\">\n                                    </i>\n                                </span>\n                                <span class=\"player-name\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-1-1-2\" data-name=\"winner display name\" data-reason=\"winner name injected\">\n                                    sarah_codes\n                                </span>\n                            </div>\n                        </td>\n                        <td data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"winner score\" data-reason=\"score updated by system\">\n                            100 / 100\n                        </td>\n                        <td data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-3\" data-name=\"winner solve time\" data-reason=\"time updated by system\">\n                            03:42.18\n                        </td>\n                        <td class=\"positive\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-4\" data-name=\"winner test results\" data-reason=\"test count updated by system\">\n                            47 / 47\n                        </td>\n                        <td class=\"positive\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-5\" data-name=\"winner elo change\" data-reason=\"ELO delta computed by system\">\n                            +22\n                        </td>\n                        <td class=\"positive\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1-6\" data-name=\"winner final rating\" data-reason=\"rating computed by system\">\n                            2,126\n                        </td>\n                    </tr>\n                    <tr class=\"loser\" data-kid=\"1-2-4-2-2-2\" data-name=\"loser row\">\n                        <td data-kid=\"1-2-4-2-2-2-1\" data-name=\"loser cell\">\n                            <div class=\"player\" data-kid=\"1-2-4-2-2-2-1-1\" data-name=\"loser player identity\">\n                                <span class=\"player-mark\" data-kid=\"1-2-4-2-2-2-1-1-1\" data-name=\"loser rank number\">\n                                    02\n                                </span>\n                                <span data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-1-1-2\" data-name=\"loser display name\" data-reason=\"loser name injected\">\n                                    devkumar_19\n                                </span>\n                            </div>\n                        </td>\n                        <td data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"loser score\" data-reason=\"score updated by system\">\n                            64 / 100\n                        </td>\n                        <td data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-3\" data-name=\"loser solve time\" data-reason=\"time updated by system\">\n                            04:11.90\n                        </td>\n                        <td data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-4\" data-name=\"loser test results\" data-reason=\"test count updated by system\">\n                            31 / 47\n                        </td>\n                        <td class=\"negative\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-5\" data-name=\"loser elo change\" data-reason=\"ELO delta computed by system\">\n                            −22\n                        </td>\n                        <td data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2-6\" data-name=\"loser final rating\" data-reason=\"rating computed by system\">\n                            1,820\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </section>\n        <section class=\"section\" data-kid=\"1-2-5\" data-name=\"match timeline section\">\n            <div class=\"section-heading\" data-kid=\"1-2-5-1\" data-name=\"timeline section heading\">\n                <h2 data-kid=\"1-2-5-1-1\" data-name=\"timeline title\">\n                    match_timeline\n                </h2>\n                <span data-kid=\"1-2-5-1-2\" data-name=\"timeline clock note\">\n                    server clock · UTC\n                </span>\n            </div>\n            <div class=\"timeline\" data-kid=\"1-2-5-2\" data-name=\"timeline track\">\n                <div class=\"event done\" data-kid=\"1-2-5-2-1\" data-name=\"read phase event\">\n                    <span class=\"event-dot\" data-kid=\"1-2-5-2-1-1\" data-name=\"read phase dot\">\n                    </span>\n                    <span class=\"event-name\" data-kid=\"1-2-5-2-1-2\" data-name=\"read phase name\">\n                        read phase\n                    </span>\n                    <span class=\"event-time\" data-dynamic=\"true\" data-kid=\"1-2-5-2-1-3\" data-name=\"read phase timing\" data-reason=\"timestamp updated by event log\">\n                        00:00 / 00:45\n                    </span>\n                </div>\n                <div class=\"event done\" data-kid=\"1-2-5-2-2\" data-name=\"first run event\">\n                    <span class=\"event-dot\" data-kid=\"1-2-5-2-2-1\" data-name=\"first run dot\">\n                    </span>\n                    <span class=\"event-name\" data-kid=\"1-2-5-2-2-2\" data-name=\"first run name\">\n                        first run\n                    </span>\n                    <span class=\"event-time\" data-dynamic=\"true\" data-kid=\"1-2-5-2-2-3\" data-name=\"first run timing\" data-reason=\"timestamp updated by event log\">\n                        02:16\n                    </span>\n                </div>\n                <div class=\"event done\" data-kid=\"1-2-5-2-3\" data-name=\"submit event\">\n                    <span class=\"event-dot\" data-kid=\"1-2-5-2-3-1