      <div data-kid=\"1-1-5-2-7-1\">\n                    </div>\n                    <div class=\"tn-empty\" data-kid=\"1-1-5-2-7-2\">\n                        <b data-kid=\"1-1-5-2-7-2-1\">\n                            empty_history\n                        </b>\n                        <span data-kid=\"1-1-5-2-7-2-2\">\n                            no older matches in this window\n                        </span>\n                    </div>\n                    <div data-kid=\"1-1-5-2-7-3\">\n                    </div>\n                </div>\n                <div class=\"tn-state-row\" data-kid=\"1-1-5-2-8\">\n                    <div data-kid=\"1-1-5-2-8-1\">\n                    </div>\n                    <div data-kid=\"1-1-5-2-8-2\">\n                        <span class=\"tn-state-label\" data-kid=\"1-1-5-2-8-2-1\">\n                            loading_state / fetch_recent_duels\n                        </span>\n                    </div>\n                    <div class=\"tn-skeleton\" data-dynamic=\"true\" data-kid=\"1-1-5-2-8-3\" data-name=\"loading shimmer animation\" data-reason=\"animation indicates dynamic content loading state\">\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"tn-footer\" data-kid=\"1-1-6\">\n            <span data-kid=\"1-1-6-1\">\n                <code data-kid=\"1-1-6-1-1\">\n                    duecit://profiles/alex_k\n                </code>\n                · public readout\n            </span>\n            <span data-kid=\"1-1-6-2\">\n                <span class=\"tn-green\" data-kid=\"1-1-6-2-1\">\n                    system nominal\n                </span>\n                · theme persists locally\n            </span>\n        </footer>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const root = document.getElementById('tnProfile');\n  const themeButton = document.getElementById('tnTheme');\n  const themeText = document.getElementById('tnThemeText');\n  themeButton?.addEventListener('click', () => {\n    root.classList.toggle('tn-light');\n    const light = root.classList.contains('tn-light');\n    themeText.textContent = light ? 'light_mode' : 'dark_mode';\n  });\n</script>\n",
