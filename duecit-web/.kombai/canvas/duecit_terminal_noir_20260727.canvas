      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  .tn-root {\n    --tn-ink: #010B13;\n    --tn-carbon: #1B1B1B;\n    --tn-panel: #11171B;\n    --tn-panel-2: #151D22;\n    --tn-line: #26343B;\n    --tn-line-soft: #1A272E;\n    --tn-text: #E6EEF2;\n    --tn-muted: #A6B2BC;\n    --tn-dim: #66747D;\n    --tn-green: #00FF40;\n    --tn-green-dim: rgba(0,255,64,.10);\n    --tn-amber: #FFB84A;\n    --tn-red: #FF6675;\n    box-sizing: border-box;\n    min-height: 100vh;\n    background: var(--tn-ink);\n    color: var(--tn-text);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    line-height: 1.55;\n    letter-spacing: -0.02em;\n    overflow: hidden;\n  }\n  .tn-root.light {\n    --tn-ink: #E9EEF0;\n    --tn-carbon: #F7F9FA;\n    --tn-panel: #F1F5F6;\n    --tn-panel-2: #E7EEF0;\n    --tn-line: #BFCBD0;\n    --tn-line-soft: #D3DEE2;\n    --tn-text: #071016;\n    --tn-muted: #4E5C64;\n    --tn-dim: #76858E;\n    --tn-green: #008B2A;\n    --tn-green-dim: rgba(0,139,42,.10);\n    --tn-amber: #A05E00;\n    --tn-red: #B53242;\n  }\n  .tn-root *, .tn-root *::before, .tn-root *::after { box-sizing: border-box; }\n  .tn-shell { width: min(100%, 1440px); margin: 0 auto; padding: 0 28px; }\n  .tn-command-bar { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--tn-line); background: color-mix(in srgb, var(--tn-ink) 94%, transparent); backdrop-filter: blur(12px); }\n  .tn-command-inner { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }\n  .tn-brand { display: inline-flex; align-items: center; gap: 12px; color: var(--tn-text); text-decoration: none; white-space: nowrap; }\n  .tn-brand-mark { width: 27px; height: 27px; display: grid; place-items: center; color: var(--tn-ink); background: var(--tn-green); font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 14px; border: 1px solid var(--tn-green); }\n  .tn-brand-name { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 700; letter-spacing: -0.05em; }\n  .tn-brand-meta { color: var(--tn-dim); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; margin-left: 2px; }\n  .tn-nav { display: flex; align-items: center; gap: 24px; margin-left: auto; }\n  .tn-nav a { color: var(--tn-muted); text-decoration: none; font-size: 12px; transition: color .18s ease; }\n  .tn-nav a::before { content: ''; color: var(--tn-green); }\n  .tn-nav a:hover { color: var(--tn-green); }\n  .tn-live { display: inline-flex; align-items: center; gap: 7px; color: var(--tn-muted); font-size: 11px; padding-left: 20px; border-left: 1px solid var(--tn-line); white-space: nowrap; }\n  .tn-live-dot { width: 6px; height: 6px; background: var(--tn-green); box-shadow: 0 0 0 3px var(--tn-green-dim); animation: tn-pulse 2s ease-in-out infinite; }\n  .tn-util { display: inline-flex; align-items: center; gap: 8px; color: var(--tn-dim); font-size: 11px; white-space: nowrap; }\n  .tn-key { border: 1px solid var(--tn-line); padding: 3px 6px; color: var(--tn-muted); font-size: 10px; background: var(--tn-carbon); }\n  .tn-theme { width: 30px; height: 30px; padding: 0; display: grid; place-items: center; border: 1px solid var(--tn-line); background: var(--tn-carbon); color: var(--tn-muted); cursor: pointer; position: relative; overflow: hidden; transition: border-color .2s ease, color .2s ease, transform .2s ease; }\n  .tn-theme:hover { border-color: var(--tn-green); color: var(--tn-green); transform: translateY(-1px); }\n  .tn-theme i { position: absolute; width: 14px; height: 14px; transition: opacity .25s ease, transform .35s ease; }\n  .tn-theme .tn-sun { opacity: 0; transform: rotate(-90deg) scale(.6); }\n  .tn-theme .tn-moon { opacity: 1; transform: rotate(0) scale(1); }\n  .tn-root.light .tn-theme .tn-sun { opacity: 1; transform: rotate(0) scale(1); }\n  .tn-root.light .tn-theme .tn-moon { opacity: 0; transform: rotate(90deg) scale(.6); }\n  .tn-section-rule { border-top: 1px solid var(--tn-line); }\n  .tn-hero { position: relative; padding: 48px 0 40px; }\n  .tn-grid-12 { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }\n  .tn-hero-grid { border-left: 1px solid var(--tn-line); border-top: 1px solid var(--tn-line); }\n  .tn-hero-copy { grid-column: span 5; padding: 42px 36px 48px; border-right: 1px solid var(--tn-line); border-bottom: 1px solid var(--tn-line); min-height: 578px; display: flex; flex-direction: column; justify-content: space-between; animation: tn-reveal .65s cubic-bezier(.22,1,.36,1) both; }\n  .tn-overline { display: flex; align-items: center; gap: 10px; color: var(--tn-green); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }\n  .tn-overline .tn-line { width: 28px; height: 1px; background: var(--tn-green); }\n  .tn-h1 { margin: 30px 0 0; max-width: 620px; font-family: 'Space Grotesk', sans-serif; font-size: clamp(50px, 5.5vw, 84px); font-weight: 600; line-height: .96; letter-spacing: -.075em; color: var(--tn-text); }\n  .tn-h1 .tn-accent { color: var(--tn-green); }\n  .tn-copy { max-width: 410px; margin-top: 24px; color: var(--tn-muted); font-size: 13px; line-height: 1.8; }\n  .tn-cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }\n  .tn-cta { display: inline-flex; align-items: center; gap: 11px; min-height: 42px; padding: 0 15px; border: 1px solid var(--tn-green); color: var(--tn-ink); background: var(--tn-green); text-decoration: none; font-size: 12px; font-weight: 700; transition: transform .18s ease, background .18s ease, color .18s ease; }\n  .tn-cta:hover { transform: translateY(-2px); background: transparent; color: var(--tn-green); }\n  .tn-cta-secondary { background: transparent; color: var(--tn-muted); border-color: var(--tn-line); }\n  .tn-cta-secondary:hover { border-color: var(--tn-muted); color: var(--tn-text); background: var(--tn-carbon); }\n  .tn-cta-prompt { color: inherit; opacity: .6; }\n  .tn-copy-foot { display: flex; align-items: center; gap: 11px; color: var(--tn-dim); font-size: 10px; }\n  .tn-copy-foot .tn-caret { width: 7px; height: 14px; background: var(--tn-green); animation: tn-caret 1.1s steps(1,end) infinite; }\n  .tn-visual { grid-column: span 7; padding: 30px; border-right: 1px solid var(--tn-line); border-bottom: 1px solid var(--tn-line); background: var(--tn-carbon); animation: tn-reveal .65s .12s cubic-bezier(.22,1,.36,1) both; }\n  .tn-terminal { height: 100%; min-height: 516px; border: 1px solid var(--tn-line); background: #0A1115; display: flex; flex-direction: column; box-shadow: 14px 14px 0 rgba(0,0,0,.12); }\n  .tn-root.light .tn-terminal { background: #10181C; color: #E6EEF2; }\n  .tn-terminal-top { min-height: 42px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #24333A; padding: 0 14px; color: #80919A; font-size: 10px; }\n  .tn-terminal-dots { display: inline-flex; gap: 6px; }\n  .tn-terminal-dots span { width: 7px; height: 7px; border: 1px solid #607079; }\n  .tn-terminal-dots span:first-child { background: var(--tn-green); border-color: var(--tn-green); }\n  .tn-terminal-file { color: #C5D1D6; margin-left: 4px; }\n  .tn-terminal-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; color: var(--tn-green); font-size: 10px; }\n  .tn-terminal-body { flex: 1; display: grid; grid-template-columns: 1.14fr .86fr; min-height: 0; }\n  .tn-editor, .tn-opponent { padding: 18px 18px 16px; }\n  .tn-editor { border-right: 1px solid #24333A; }\n  .tn-pane-label { display: flex; align-items: center; justify-content: space-between; color: #80919A; font-size: 10px; text-transform: uppercase; letter-spacing: .10em; padding-bottom: 13px; border-bottom: 1px solid #24333A; }\n  .tn-pane-label strong { font-weight: 500; color: #C5D1D6; letter-spacing: .02em; text-transform: none; }\n  .tn-code { padding-top: 16px; font-size: 12px; line-height: 1.9; color: #B8C5CA; }\n  .tn-code-line { display: grid; grid-template-columns: 24px minmax(0,1fr); gap: 12px; min-height: 23px; }\n  .tn-ln { color: #53636B; text-align: right; user-select: none; }\n  .tn-kw { color: #C58CFF; }\n  .tn-fn { color: #6FC3FF; }\n  .tn-str { color: var(--tn-green); }\n  .tn-num { color: var(--tn-amber); }\n  .tn-cm { color: #60747D; }\n  .tn-blink { display: inline-block; width: 7px; height: 14px; background: var(--tn-green); vertical-align: -2px; animation: tn-caret 1.1s steps(1,end) infinite; }\n  .tn-opponent { background: #0D1519; }\n  .tn-opponent-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }\n  .tn-player { display: flex; align-items: center; gap: 9px; color: #E6EEF2; font-weight: 600; }\n  .tn-avatar { width: 26px; height: 26px; display: grid; place-items: center; border: 1px solid #53636B; color: #D2DEE2; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 11px; }\n  .tn-rating { color: var(--tn-green); font-size: 11px; font-weight: 500; }\n  .tn-opponent-status { color: var(--tn-green); font-size: 10px; margin-top: 16px; padding: 8px 9px; border-left: 2px solid var(--tn-green); background: rgba(0,255,64,.06); }\n  .tn-mini-stat { display: flex; justify-content: space-between; gap: 10px; padding: 12px 0; border-bottom: 1px solid #24333A; color: #7F9098; font-size: 10px; }\n  .tn-mini-stat strong { color: #D8E2E5; font-weight: 500; }\n  .tn-sparkline { height: 70px; position: relative; margin: 18px 0; border-bottom: 1px solid #24333A; overflow: hidden; }\n  .tn-sparkline svg { width: 100%; height: 100%; overflow: visible; }\n  .tn-sparkline path { fill: none; stroke: var(--tn-green); stroke-width: 1.4; stroke-dasharray: 220; stroke-dashoffset: 0; animation: tn-draw 2.4s ease both; }\n  .tn-judge { margin-top: auto; border-top: 1px solid #24333A; padding-top: 14px; }\n  .tn-judge-label { display: flex; align-items: center; justify-content: space-between; color: #80919A; font-size: 10px; margin-bottom: 9px; }\n  .tn-progress { height: 5px; background: #203039; }\n  .tn-progress span { display: block; width: 84%; height: 100%; background: var(--tn-green); animation: tn-progress 1.2s ease both; }\n  .tn-terminal-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; border-top: 1px solid #24333A; padding: 0 14px; color: #82939A; font-size: 10px; }\n  .tn-terminal-result { display: inline-flex; align-items: center; gap: 7px; color: var(--tn-green); }\n  .tn-terminal-result i { width: 13px; height: 13px; }\n  .tn-timer { color: #E6EEF2; font-size: 13px; }\n  .tn-timer small { color: #71828A; font-size: 9px; margin-right: 6px; }\n  .tn-vs-strip { grid-column: 1 / -1; border-top: 1px solid #24333A; display: grid; grid-template-columns: 1fr auto 1fr; min-height: 46px; align-items: center; color: #80919A; font-size: 10px; }\n  .tn-vs-strip > span { padding: 0 14px; }\n  .tn-vs-strip > span:last-child { text-align: right; }\n  .tn-vs { color: var(--tn-green); border-left: 1px solid #24333A; border-right: 1px solid #24333A; height: 100%; display: grid; place-items: center; min-width: 56px; }\n  .tn-proof { border-top: 1px solid var(--tn-line); border-bottom: 1px solid var(--tn-line); display: grid; grid-template-columns: 1.2fr repeat(3, 1fr); animation: tn-reveal .65s .25s cubic-bezier(.22,1,.36,1) both; }\n  .tn-proof-item { min-height: 74px; display: flex; align-items: center; gap: 12px; padding: 0 18px; border-right: 1px solid var(--tn-line); }\n  .tn-proof-item:last-child { border-right: 0; }\n  .tn-proof-key { color: var(--tn-green); font-size: 11px; }\n  .tn-proof-copy { color: var(--tn-muted); font-size: 11px; line-height: 1.4; }\n  .tn-proof-copy strong { display: block; color: var(--tn-text); font-weight: 500; }\n  .tn-section { padding: 76px 0; }\n  .tn-section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding-bottom: 22px; border-bottom: 1px solid var(--tn-line); }\n  .tn-kicker { color: var(--tn-green); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }\n  .tn-section-title { margin: 8px 0 0; font-family: 'Space Grotesk', sans-serif; font-size: clamp(30px, 3.2vw, 48px); line-height: 1; letter-spacing: -.06em; font-weight: 600; }\n  .tn-section-note { max-width: 340px; color: var(--tn-muted); font-size: 11px; line-height: 1.7; }\n  .tn-process { display: grid; grid-template-columns: repeat(4, 1fr); border-left: 1px solid var(--tn-line); border-bottom: 1px solid var(--tn-line); }\n  .tn-process-step { min-height: 170px; padding: 20px; border-right: 1px solid var(--tn-line); border-top: 1px solid var(--tn-line); position: relative; }\n  .tn-process-step::after { content: '→'; position: absolute; right: 17px; top: 18px; color: var(--tn-dim); }\n  .tn-process-step:last-child::after { content: '✓'; color: var(--tn-green); }\n  .tn-step-no { color: var(--tn-green); font-size: 10px; }\n  .tn-step-title { margin: 42px 0 9px; font-family: 'Space Grotesk', sans-serif; font-size: 21px; letter-spacing: -.04em; }\n  .tn-step-body { color: var(--tn-muted); font-size: 11px; line-height: 1.7; max-width: 190px; }\n  .tn-protocol { display: grid; grid-template-columns: 5fr 7fr; border-left: 1px solid var(--tn-line); border-bottom: 1px solid var(--tn-line); }\n  .tn-protocol-copy, .tn-protocol-list { padding: 28px; border-right: 1px solid var(--tn-line); border-top: 1px solid var(--tn-line); }\n  .tn-protocol-copy p { color: var(--tn-muted); max-width: 420px; line-height: 1.8; font-size: 12px; }\n  .tn-protocol-code { margin-top: 28px; color: var(--tn-green); font-size: 11px; }\n  .tn-protocol-code span { color: var(--tn-muted); }\n  .tn-readout { display: grid; grid-template-columns: 1fr auto; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--tn-line-soft); }\n  .tn-readout:last-child { border-bottom: 0; }\n  .tn-readout-label { color: var(--tn-muted); font-size: 11px; }\n  .tn-readout-value { color: var(--tn-text); font-size: 11px; text-align: right; }\n  .tn-readout-value.green { color: var(--tn-green); }\n  .tn-footer { border-top: 1px solid var(--tn-line); padding: 23px 0 30px; color: var(--tn-dim); font-size: 10px; }\n  .tn-footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 18px; }\n  .tn-footer-links { display: flex; gap: 18px; }\n  .tn-footer-links a { color: var(--tn-muted); text-decoration: none; }\n  .tn-footer-links a:hover { color: var(--tn-green); }\n  .tn-fade { animation: tn-reveal .65s cubic-bezier(.22,1,.36,1) both; }\n  @keyframes tn-reveal { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }\n  @keyframes tn-caret { 0%, 48% { opacity: 1; } 49%, 100% { opacity: 0; } }\n  @keyframes tn-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.78); } }\n  @keyframes tn-progress { from { width: 0; } to { width: 84%; } }\n  @keyframes tn-draw { from { stroke-dashoffset: 220; opacity: .2; } to { stroke-dashoffset: 0; opacity: 1; } }\n  @media (max-width: 1020px) {\n    .tn-shell { padding: 0 20px; }\n    .tn-nav { gap: 14px; }\n    .tn-live, .tn-util { display: none; }\n    .tn-hero-copy { grid-column: span 12; min-height: 0; border-right: 1px solid var(--tn-line); }\n    .tn-visual { grid-column: span 12; }\n    .tn-proof { grid-template-columns: repeat(2, 1fr); }\n    .tn-proof-item:nth-child(2) { border-bottom: 1px solid var(--tn-line); }\n    .tn-proof-item:nth-child(3) { border-bottom: 1px solid var(--tn-line); }\n    .tn-process { grid-template-columns: repeat(2, 1fr); }\n  }\n  @media (max-width: 640px) {\n    .tn-shell { padding: 0 14px; }\n    .tn-command-inner { min-height: 58px; }\n    .tn-brand-meta, .tn-nav a:nth-child(2), .tn-nav a:nth-child(3) { display: none; }\n    .tn-nav { gap: 10px; }\n    .tn-hero { padding-top: 20px; }\n    .tn-hero-copy { padding: 28px 20px 30px; }\n    .tn-h1 { font-size: 50px; }\n    .tn-visual { padding: 14px; }\n    .tn-terminal-body { grid-template-columns: 1fr; }\n    .tn-editor { border-right: 0; border-bottom: 1px solid #24333A; }\n    .tn-opponent { min-height: 250px; }\n    .tn-proof { grid-template-columns: 1fr; }\n    .tn-proof-item { border-right: 0; border-bottom: 1px solid var(--tn-line); }\n    .tn-proof-item:last-child { border-bottom: 0; }\n    .tn-process, .tn-protocol { grid-template-columns: 1fr; }\n    .tn-process-step { border-right: 0; }\n    .tn-protocol-copy, .tn-protocol-list { border-right: 0; }\n    .tn-footer-inner { align-items: flex-start; flex-direction: column; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .tn-root *, .tn-root *::before, .tn-root *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }\n  }\n</style>\n<div class=\"tn-root\" data-kid=\"1\" id=\"duecit-terminal-noir\">\n    <header class=\"tn-command-bar\" data-kid=\"1-1\">\n        <div class=\"tn-shell tn-command-inner\" data-kid=\"1-1-1\">\n            <a aria-label=\"DuecIt home\" class=\"tn-brand\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"tn-brand-mark\" data-kid=\"1-1-1-1-1\">\n                    >_\n                </span>\n                <span class=\"tn-brand-name\" data-kid=\"1-1-1-1-2\">\n                    DuecIt\n                </span>\n                <span class=\"tn-brand-meta\" data-kid=\"1-1-1-1-3\">\n                    // duel protocol v1\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"tn-nav\" data-kid=\"1-1-1-2\">\n                <a data-kid=\"1-1-1-2-1\" href=\"#arena\">\n                    /arena\n                </a>\n                <a data-kid=\"1-1-1-2-2\" href=\"#leaderboard\">\n                    /leaderboard\n                </a>\n                <a data-kid=\"1-1-1-2-3\" href=\"#protocol\">\n                    /docs\n                </a>\n           