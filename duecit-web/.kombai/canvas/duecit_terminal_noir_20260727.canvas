      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n\n  :root {\n    --ink: #010b13;\n    --panel: #07131d;\n    --panel-2: #0b1924;\n    --line: #20303b;\n    --line-bright: #30434e;\n    --text: #e6fff0;\n    --muted: #78908a;\n    --faint: #4e625f;\n    --accent: #00ff40;\n    --accent-soft: rgba(0,255,64,.10);\n    --amber: #f1bf55;\n    --red: #ff6d5f;\n    --shadow: rgba(0,0,0,.28);\n  }\n  #terminal-app[data-theme=\"light\"] {\n    --ink: #edf4f0;\n    --panel: #f6faf7;\n    --panel-2: #e7f0eb;\n    --line: #c8d6cf;\n    --line-bright: #a5b9af;\n    --text: #102118;\n    --muted: #5a7467;\n    --faint: #89a095;\n    --accent: #098f39;\n    --accent-soft: rgba(9,143,57,.10);\n    --amber: #9b6700;\n    --red: #c63f33;\n    --shadow: rgba(19,50,34,.10);\n  }\n  .tn-body { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--ink); color: var(--text); }\n  .tn-display { font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; }\n  .tn-shell { background: radial-gradient(circle at 86% 10%, rgba(0,255,64,.055), transparent 24rem), var(--ink); }\n  .tn-grid { background-image: linear-gradient(to right, color-mix(in srgb, var(--line) 42%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in srgb, var(--line) 42%, transparent) 1px, transparent 1px); background-size: 42px 42px; mask-image: linear-gradient(to bottom, #000 0%, transparent 72%); }\n  .tn-panel { background: color-mix(in srgb, var(--panel) 94%, transparent); border: 1px solid var(--line); box-shadow: 0 14px 26px -24px var(--shadow); }\n  .tn-label { color: var(--muted); font-size: 10px; line-height: 1; letter-spacing: .16em; text-transform: uppercase; }\n  .tn-mono { font-variant-numeric: tabular-nums; }\n  .tn-rule { border-color: var(--line); }\n  .tn-nav-item { border-left: 2px solid transparent; color: var(--muted); }\n  .tn-nav-item:hover { color: var(--text); background: color-mix(in srgb, var(--accent) 5%, transparent); }\n  .tn-nav-item[data-active=\"true\"] { border-left-color: var(--accent); color: var(--accent); background: var(--accent-soft); }\n  .tn-seg { border: 1px solid var(--line); color: var(--muted); background: var(--panel); }\n  .tn-seg:hover { color: var(--text); border-color: var(--line-bright); }\n  .tn-seg[data-selected=\"true\"] { border-color: var(--accent); color: var(--ink); background: var(--accent); }\n  .tn-command { letter-spacing: .02em; }\n  .tn-command:hover { border-color: var(--accent); }\n  .tn-scan { position: relative; overflow: hidden; }\n  .tn-scan::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--accent) 7%, transparent), transparent); transform: translateY(-100%); animation: scan 7s linear infinite; }\n  .tn-dot { width: 6px; height: 6px; background: var(--accent); display: inline-block; animation: breathe 1.8s ease-in-out infinite; }\n  .tn-caret { width: 7px; height: 1.1em; background: var(--accent); display: inline-block; vertical-align: -.15em; animation: blink 1s steps(1) infinite; }\n  .tn-skeleton { background: linear-gradient(90deg, color-mix(in srgb, var(--line) 35%, transparent), color-mix(in srgb, var(--line-bright) 55%, transparent), color-mix(in srgb, var(--line) 35%, transparent)); background-size: 220% 100%; animation: shimmer 1.7s ease-in-out infinite; }\n  .tn-orbit { border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent); border-left-color: var(--accent); animation: orbit 1.7s linear infinite; }\n  .tn-key { color: var(--faint); border: 1px solid var(--line); background: var(--panel-2); padding: 2px 5px; font-size: 10px; }\n  .tn-progress { height: 4px; background: var(--panel-2); overflow: hidden; }\n  .tn-progress > span { display: block; height: 100%; background: var(--accent); }\n  .tn-row:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }\n  .tn-link { color: var(--muted); text-decoration: none; }\n  .tn-link:hover { color: var(--accent); }\n  .tn-reveal { animation: reveal .55s cubic-bezier(.2,.8,.2,1) both; }\n  .tn-delay-1 { animation-delay: .06s; }\n  .tn-delay-2 { animation-delay: .12s; }\n  .tn-delay-3 { animation-delay: .18s; }\n  .tn-delay-4 { animation-delay: .24s; }\n  @keyframes reveal { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n  @keyframes blink { 0%, 45% { opacity: 1; } 46%, 100% { opacity: 0; } }\n  @keyframes breathe { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.75); } }\n  @keyframes shimmer { 0% { background-position: 110% 0; } 100% { background-position: -110% 0; } }\n  @keyframes orbit { to { transform: rotate(360deg); } }\n  @keyframes scan { 0% { transform: translateY(-100%); } 70%, 100% { transform: translateY(100%); } }\n  @media (prefers-reduced-motion: reduce) { .tn-reveal, .tn-dot, .tn-caret, .tn-skeleton, .tn-orbit, .tn-scan::after { animation: none !important; } }\n  @media (max-width: 920px) { .tn-sidebar { width: 68px !important; } .tn-sidebar .tn-wordmark, .tn-sidebar .tn-nav-label, .tn-sidebar .tn-sidebar-copy, .tn-sidebar .tn-sidebar-meta { display: none; } .tn-main { margin-left: 68px !important; } .tn-nav-item { justify-content: center; padding-left: 0 !important; padding-right: 0 !important; } }\n  @media (max-width: 700px) { .tn-main { margin-left: 0 !important; } .tn-sidebar { display: none; } .tn-content { padding-left: 20px !important; padding-right: 20px !important; } }\n</style>\n<div class=\"tn-body tn-shell min-h-screen\" data-dynamic=\"true\" data-kid=\"1\" data-name=\"terminal application root\" data-reason=\"data-theme attribute updated by theme toggle script\" data-theme=\"dark\" id=\"terminal-app\">\n    <div aria-hidden=\"true\" class=\"tn-grid pointer-events-none fixed inset-0 opacity-60\" data-kid=\"1-1\">\n    </div>\n    <aside class=\"tn-sidebar fixed inset-y-0 left-0 z-30 flex w-64 flex-col border-r tn-rule bg-[var(--panel)]/95 transition-colors duration-300\" data-kid=\"1-2\">\n        <div class=\"flex h-16 items-center gap-3 border-b tn-rule px-5\" data-kid=\"1-2-1\">\n            <div aria-hidden=\"true\" class=\"flex h-8 w-8 items-center justify-center border border-[var(--accent)] text-[var(--accent)]\" data-kid=\"1-2-1-1\">\n                <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-1\" data-lucide=\"terminal\" data-name=\"terminal icon\">\n                </i>\n            </div>\n            <div class=\"tn-wordmark\" data-kid=\"1-2-1-2\">\n                <div class=\"tn-display text-[15px] font-semibold tracking-tight\" data-kid=\"1-2-1-2-1\">\n                    DuecIt\n                    <span class=\"text-[var(--accent)]\" data-kid=\"1-2-1-2-1-1\">\n                        _\n                    </span>\n                </div>\n                <div class=\"tn-label mt-1\" data-kid=\"1-2-1-2-2\">\n                    developer duels\n                </div>\n            </div>\n        </div>\n        <div class=\"tn-sidebar-copy px-5 pt-7\" data-kid=\"1-2-2\">\n            <div class=\"tn-label\" data-kid=\"1-2-2-1\">\n                workspace\n            </div>\n            <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[var(--text)]\" data-kid=\"1-2-2-2\">\n                <span class=\"tn-dot\" data-kid=\"1-2-2-2-1\" data-name=\"status light dot\">\n                </span>\n                <span data-kid=\"1-2-2-2-2\">\n                    /arena\n                </span>\n            </div>\n        </div>\n        <nav aria-label=\"Primary\" class=\"mt-6 flex-1 space-y-1 px-3\" data-kid=\"1-2-3\">\n            <a class=\"tn-nav-item flex items-center gap-3 px-3 py-2.5 text-[12px] transition-colors\" data-active=\"true\" data-kid=\"1-2-3-1\" href=\"#\">\n                <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-2-3-1-1\" data-lucide=\"crosshair\">\n                </i>\n                <span class=\"tn-nav-label\" data-kid=\"1-2-3-1-2\">\n                    /arena\n                </span>\n            </a>\n            <a class=\"tn-nav-item flex items-center gap-3 px-3 py-2.5 text-[12px] transition-colors\" data-kid=\"1-2-3-2\" href=\"#duel-log\">\n                <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-2-3-2-1\" data-lucide=\"history\">\n                </i>\n                <span class=\"tn-nav-label\" data-kid=\"1-2-3-2-2\">\n                    /history\n                </span>\n            </a>\n            <a class=\"tn-nav-item flex items-center gap-3 px-3 py-2.5 text-[12px] transition-colors\" data-kid=\"1-2-3-3\" href=\"#profile\">\n                <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-2-3-3-1\" data-lucide=\"user-round\">\n                </i>\n                <span class=\"tn-nav-label\" data-kid=\"1-2-3-3-2\">\n                    /profile\n                </span>\n            </a>\n            <a class=\"tn-nav-item flex items-center gap-3 px-3 py-2.5 text-[12px] transition-colors\" data-kid=\"1-2-3-4\" href=\"#settings\">\n                <i class=\"h-4 w-4 shrink-0\" data-kid=\"1-2-3-4-1\" data-lucide=\"settings-2\">\n                </i>\n                <span class=\"tn-nav-label\" data-kid=\"1-2-3-4-2\">\n                    /settings\n                </span>\n            </a>\n        </nav>\n        <div class=\"tn-sidebar-meta border-t tn-rule px-5 py-5\" data-kid=\"1-2-4\">\n            <div class=\"flex items-center gap-2 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-4-1\">\n                <span class=\"tn-dot\" data-kid=\"1-2-4-1-1\" data-name=\"api status light dot\">\n                </span>\n                api connected\n            </div>\n            <div class=\"mt-2 text-[10px] text-[var(--faint)]\" data-kid=\"1-2-4-2\">\n                latency 42ms · region iad1\n            </div>\n            <div class=\"tn-label mt-6\" data-kid=\"1-2-4-3\">\n                session\n            </div>\n            <div class=\"mt-2 flex items-center justify-between gap-3 text-[11px]\" data-kid=\"1-2-4-4\">\n                <span class=\"truncate text-[var(--muted)]\" data-kid=\"1-2-4-4-1\">\n                    @sarah_codes\n                </span>\n                <span class=\"tn-key\" data-kid=\"1-2-4-4-2\">\n                    ⌘K\n                </span>\n            </div>\n        </div>\n    </aside>\n    <div class=\"tn-main relative ml-64 min-h-screen transition-[margin] duration-300\" data-kid=\"1-3\">\n        <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b tn-rule bg-[var(--ink)]/90 px-6 backdrop-blur-md lg:px-10\" data-kid=\"1-3-1\">\n            <div class=\"flex items-center gap-3 text-[11px] text-[var(--muted)]\" data-kid=\"1-3-1-1\">\n                <span class=\"text-[var(--accent)]\" data-kid=\"1-3-1-1-1\">\n                    duecit\n                </span>\n                <span class=\"text-[var(--faint)]\" data-kid=\"1-3-1-1-2\">\n                    /\n                </span>\n                <span data-kid=\"1-3-1-1-3\">\n                    arena\n                </span>\n                <span class=\"text-[var(--faint)]\" data-kid=\"1-3-1-1-4\">\n                    /\n                </span>\n                <span class=\"text-[var(--text)]\" data-kid=\"1-3-1-1-5\">\n                    queue\n                </span>\n                <span aria-hidden=\"true\" class=\"tn-caret ml-1\" data-dynamic=\"true\" data-kid=\"1-3-1-1-6\" data-name=\"blinking text caret\" data-reason=\"animation controlled by CSS\">\n                </span>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-3-1-2\">\n                <div class=\"hidden items-center gap-2 text-[11px] text-[var(--muted)] sm:flex\" data-kid=\"1-3-1-2-1\">\n                    <span class=\"tn-dot\" data-kid=\"1-3-1-2-1-1\" data-name=\"live status light dot\">\n                    </span>\n                    LIVE / 3,842 online\n                </div>\n                <div class=\"hidden items-center gap-2 border-l tn-rule pl-4 text-[11px] sm:flex\" data-kid=\"1-3-1-2-2\">\n                    <span class=\"text-[var(--muted)]\" data-kid=\"1-3-1-2-2-1\">\n                        @sarah_codes\n                    </span>\n                    <span class=\"text-[var(--accent)]\" data-kid=\"1-3-1-2-2-2\">\n                        1,842\n                    </span>\n                </div>\n                <button aria-label=\"Switch theme\" class=\"flex h-8 w-8 items-center justify-center border tn-rule text-[var(--muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]\" data-kid=\"1-3-1-2-3\" id=\"theme-toggle\" type=\"button\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-3-1-2-3-1\" data-lucide=\"sun-moon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <main class=\"tn-content relative mx-auto max-w-[1180px] px-10 py-10\" data-kid=\"1-3-2\">\n            <div class=\"tn-reveal flex flex-wrap items-end justify-between gap-5 border-b tn-rule pb-7\" data-kid=\"1-3-2-1\">\n                <div data-kid=\"1-3-2-1-1\">\n                    <div class=\"tn-label flex items-center gap-2\" data-kid=\"1-3-2-1-1-1\">\n                        <span class=\"tn-dot\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"matchmaking service status dot\">\n                        </span>\n                        matchmaking service / operational\n                    </div>\n                    <h1 class=\"tn-display mt-4 max-w-3xl text-5xl font-semibold leading-[.94] tracking-[-.06em] text-[var(--text)] sm:text-6xl lg:text-7xl\" data-kid=\"1-3-2-1-1-2\">\n                        Find your next\n                        <br data-kid=\"1-3-2-1-1-2-1\"/>\n                        <span class=\"text-[var(--accent)]\" data-kid=\"1-3-2-1-1-2-2\">\n                            worthy opponent.\n                        </span>\n                    </h1>\n                </div>\n                <div class=\"max-w-[260px] text-[11px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-2-1-2\">\n                    A focused arena for engineers who want the pressure of a real clock, a real peer, and a result they can inspect.\n                </div>\n            </div>\n            <section class=\"tn-reveal tn-delay-1 mt-8 grid gap-8 lg:grid-cols-[1.08fr_.92fr]\" data-kid=\"1-3-2-2\">\n                <div class=\"tn-panel tn-scan relative min-h-[312px] overflow-hidden p-6 sm:p-8\" data-kid=\"1-3-2-2-1\">\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-3-2-2-1-1\">\n                        <div data-kid=\"1-3-2-2-1-1-1\">\n                            <div class=\"tn-label\" data-kid=\"1-3-2-2-1-1-1-1\">\n                                your current rating\n                            </div>\n                            <div class=\"tn-display tn-mono mt-4 text-6xl font-semibold tracking-[-.07em] text-[var(--text)] sm:text-7xl\" data-kid=\"1-3-2-2-1-1-1-2\">\n                                1,842\n                                <span class=\"font-mono text-xl font-medium tracking-normal text-[var(--accent)]\" data-kid=\"1-3-2-2-1-1-1-2-1\">\n                                    DSA\n                                </span>\n                            </div>\n                            <div class=\"mt-3 flex items-center gap-3 text-[11px]\" data-kid=\"1-3-2-2-1-1-1-3\">\n                                <span class=\"border border-[var(--accent)]/40 bg-[var(--accent-soft)] px-2 py-1 text-[var(--accent)]\" data-kid=\"1-3-2-2-1-1-1-3-1\">\n                                    candidate\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-3-2-2-1-1-1-3-2\">\n                                    +18 this week\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"1-3-2-2-1-1-2\">\n                            <div class=\"tn-label\" data-kid=\"1-3-2-2-1-1-2-1\">\n                                rank\n                            </div>\n                            <div class=\"tn-mono mt-3 text-2xl text-[var(--text)]\" data-kid=\"1-3-2-2-1-1-2-2\">\n                                #042\n                            </div>\n                            <div class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"1-3-2-2-1-1-2-3\">\n                                of 3,842\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-12\" data-kid=\"1-3-2-2-1-2\">\n                        <div class=\"mb-2 flex items-center justify-between text-[10px] text-[var(--muted)]\" data-kid=\"1-3-2-2-1-2-1\">\n                            <span data-kid=\"1-3-2-2-1-2-1-1\">\n                                newbie / 800\n                            </span>\n                            <span data-kid=\"1-3-2-2-1-2-1-2\">\n                                master / 1900+\n                            </span>\n                        </div>\n                        <div class=\"tn-progress\" data-kid=\"1-3-2-2-1-2-2\">\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-2-1-2-2-1\" data-name=\"rating progress bar\" data-reason=\"width inline style set dynamically\" style=\"width: 73%\">\n                            </span>\n                        </div>\n                        <div class=\"mt-2 flex items-center justify-between text-[10px] text-[var(--faint)]\" data-kid=\"1-3-2-2-1-2-3\">\n                            <span data-kid=\"1-3-2-2-1-2-3-1\">\n                                1,000\n                            </span>\n                            <span data-kid=\"1-3-2-2-1-2-3-2\">\n                                1,400\n                            </span>\n                            <span data-kid=\"1-3-2-2-1-2-3-3\">\n                                1,800\n                            </span>\n                            <span data-kid=\"1-3-2-2-1-2-3-4\">\n                                2,200\n                            </span>\n                            <span data-kid=\"1-3-2-2-1-2-3-5\">\n                                2,600\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"absolute bottom-0 left-0 right-0 flex items-center justify-between border-t tn-rule bg-[var(--panel-2)]/55 px-6 py-3 text-[10px] text-[var(--muted)] sm:px-8\" data-kid=\"1-3-2-2-1-3\">\n                        <span data-kid=\"1-3-2-2-1-3-1\">\n                            last match / 11m ago\n                        </span>\n                        <span class=\"text-[var(--accent)]\" data-kid=\"1-3-2-2-1-3-2\">\n                            win · +22 elo\n                        </span>\n                    </div>\n                </div>\n                <div class=\"tn-panel p-6 sm:p-8\" data-kid=\"1-3-2-2-2\">\n                    <div class=\"flex items-center justify-between gap-4 border-b tn-rule pb-4\" data-kid=\"1-3-2-2-2-1\">\n                        <div class=\"tn-label\" data-kid=\"1-3-2-2-2-1-1\">\n                            live availability\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[10px] text-[var(--accent)]\" data-kid=\"1-3-2-2-2-1-2\">\n                            <span class=\"tn-dot\" data-kid=\"1-3-2-2-2-1-2-1\" data-name=\"accepting status light dot\">\n                            </span>\n                            accepting\n                        </div>\n                    </div>\n                    <div class=\"mt-7 flex items-end justify-between gap-5\" data-kid=\"1-3-2-2-2-2\">\n                        <d